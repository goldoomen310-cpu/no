-- ==================== ROUND STATE ====================
local Round = {
    active = false, startTime = 0, waitingSince = tick(),
    serial = 0, data = {}, busy = false, conns = {},
}
function Round.roleOf(player)
    local d = Round.data[player.Name]
    return d and d.Role or nil
end
function Round.myRole()
    local me = Round.data[LocalPlayer.Name]
    return me and me.Role or nil
end
function Round.isDead(player)
    local d = Round.data[player.Name]
    if d and d.Dead then return true end
    local char = player.Character
    if not char then return true end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum == nil or hum.Health <= 0
end
function Round.readTimer()
    local part = Workspace:FindFirstChild("RoundTimerPart")
    if not part then return nil, nil end
    return tonumber(part:GetAttribute("Time")), tonumber(part:GetAttribute("RoundLength"))
end
function Round.markEnd(reason)
    if Round.active then
        dbg("round end", reason or "")
        Round.waitingSince = tick()
    elseif not Round.waitingSince then
        Round.waitingSince = tick()
    end
    Round.active = false
    Round.startTime = 0
    Candy.Busy = false
    Candy.Target = nil
    Motion.cancelTween()
    Scan.clearMemory()
    Hide.unhide()
end
function Round.markStart(source, data)
    if type(data) == "table" then Round.data = data end
    Round.active = true
    Round.startTime = tick()
    Round.waitingSince = nil
    Round.serial = Round.serial + 1
    Candy.LastScan = 0
    Candy.Cache = {}
    Scan.clearMemory()
    Hide.resetRound()
    task.spawn(Round.refresh)
    dbg("round start", source or "")
end
function Round.detect()
    local timeLeft, roundLength = Round.readTimer()
    if not timeLeft or timeLeft <= 2 then return false end
    if not isAlive() then return false end
    if not Round.myRole() then
        task.spawn(Round.refresh)
        return false
    end
    local len = roundLength or 180
    local elapsed = math.clamp(len - timeLeft, 0, len)
    Round.active = true
    Round.startTime = tick() - elapsed
    Round.waitingSince = nil
    Round.serial = Round.serial + 1
    Candy.LastScan = 0
    Candy.Cache = {}
    Hide.resetRound()
    dbg("round already active, elapsed=", math.floor(elapsed))
    return true
end
function Round.connect(src, name, fn)
    local ev = src:FindFirstChild(name)
    if not ev then return end
    if not (ev:IsA("RemoteEvent") or ev:IsA("RemoteFunction")) then return end
    local ok, conn = pcall(function()
        if ev:IsA("RemoteEvent") then
            return ev.OnClientEvent:Connect(function(...)
                if not instanceAlive() then return end
                local good, err = pcall(fn, ...)
                if not good then warn("[round] " .. name .. ": " .. tostring(err)) end
            end)
        end
        ev.OnClientInvoke = function(...)
            if not instanceAlive() then return end
            local good, err = pcall(fn, ...)
            if not good then warn("[round] " .. name .. ": " .. tostring(err)) end
        end
        return nil
    end)
    if ok and conn then table.insert(Round.conns, conn) end
end

do
    local Gameplay = S.ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Gameplay")

    function Round.refresh()
        if Round.busy then return end
        Round.busy = true
        task.spawn(function()
            local ok, data = pcall(function()
                return Gameplay.GetCurrentPlayerData:InvokeServer()
            end)
            if ok and type(data) == "table" then Round.data = data end
            Round.busy = false
        end)
    end

    function Round.waitRole(timeout)
        local t0 = tick()
        while tick() - t0 < (timeout or 3) do
            local role = Round.myRole()
            if role then return role end
            task.spawn(Round.refresh)
            task.wait(0.35)
        end
        return Round.myRole()
    end

    Round.connect(Gameplay, "RoundStart", function(_, data)
        Round.markStart("RoundStart", data)
    end)
    Round.connect(Gameplay, "CoinsStarted", function()
        if not Round.active then Round.markStart("CoinsStarted") end
        Candy.LastScan = 0
    end)
    Round.connect(Gameplay, "RoleSelect", function(role)
        if type(role) == "string" and role ~= "" then
            Round.data[LocalPlayer.Name] = Round.data[LocalPlayer.Name] or {}
            Round.data[LocalPlayer.Name].Role = role
        end
        task.spawn(Round.refresh)
    end)
    Round.connect(Gameplay, "PlayerDataChanged", function(data)
        if type(data) == "table" then Round.data = data end
    end)
    Round.connect(Gameplay, "VictoryScreen", function() Round.markEnd("VictoryScreen") end)
    Round.connect(Gameplay, "GameOver", function() Round.markEnd("GameOver") end)
    Round.connect(Gameplay, "RoundEndFade", function() Round.markEnd("RoundEndFade") end)
    Round.connect(Gameplay, "LoadingMap", function()
        Round.markEnd("LoadingMap")
        Candy.Cache = {}
        Candy.LastScan = 0
        Hide.surfaceY = nil
        Hide.lastSafeCF = nil
    end)

    local coin = Gameplay:FindFirstChild("CoinCollected")
    if coin and coin:IsA("RemoteEvent") then
        table.insert(Round.conns, coin.OnClientEvent:Connect(function(coinId, count, cap)
            if coinId ~= nil and coinId ~= "Candy" then return end
            if type(count) == "number" then
                Candy.ServerCount = count
                if not Bag.refresh() then Candy.Collected = count end
            end
            if type(cap) == "number" and cap > 0 then Candy.Cap = cap end
        end))
    end
    task.defer(Round.refresh)
end

