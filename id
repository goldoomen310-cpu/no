-- ==================== CANDY DETECTION ====================
local VISUAL_NAMES = {
    CoinVisual = true,
    SpinningVisual = true,
    SpinningVisuals = true,
    MainCoin = true,
}

local function isCandyPart(obj)
    if not obj or not obj:IsA("BasePart") then return false end
    if VISUAL_NAMES[obj.Name] then return false end
    if obj:GetAttribute(CANDY_ATTR) == CANDY_VALUE then return true end
    local lname = obj.Name:lower()
    if lname:find("candy") or lname:find("candie") then return true end
    return false
end

local function isAvailable(obj)
    if not obj or not obj.Parent then return false end
    if obj:GetAttribute("Collected") == true then return false end
    if obj:GetAttribute("Delete") == true then return false end
    return true
end

local function candyContainers()
    local out = {}
    for _, child in ipairs(Workspace:GetChildren()) do
        local cc
        if child.Name == "CoinContainer" then
            cc = child
        else
            cc = child:FindFirstChild("CoinContainer")
        end
        if cc then out[#out + 1] = cc end
    end
    return out
end

local function scanCandies(root)
    local list, cache = {}, {}
    local playerPos = root.Position
    for _, cc in ipairs(candyContainers()) do
        for _, obj in ipairs(cc:GetChildren()) do
            if isCandyPart(obj) and isAvailable(obj) then
                cache[#cache + 1] = obj
                local d = (obj.Position - playerPos).Magnitude
                if d <= Candy.MaxDistance then
                    list[#list + 1] = { obj = obj, dist = d }
                end
            end
        end
    end
    Candy.Cache = cache
    Candy.LastScan = tick()
    return list
end

local function findCandies(force)
    local root = getRoot()
    if not root then return {} end
    local now = tick()

    if force or (now - Candy.LastScan) > Candy.CacheTTL or #Candy.Cache == 0 then
        return scanCandies(root)
    end

    local list = {}
    local playerPos = root.Position
    for _, obj in ipairs(Candy.Cache) do
        if isAvailable(obj) then
            local d = (obj.Position - playerPos).Magnitude
            if d <= Candy.MaxDistance then
                list[#list + 1] = { obj = obj, dist = d }
            end
        end
    end
    if #list == 0 then
        return scanCandies(root)
    end
    return list
end

-- ==================== MURDERER DANGER DETECTION ====================
local function hasKnifeOn(player)
    player = player or LocalPlayer
    local char = player.Character
    if char and char:FindFirstChild("Knife") then return true end
    local backpack = player:FindFirstChild("Backpack")
    if not backpack and char then backpack = char:FindFirstChildOfClass("Backpack") end
    return backpack ~= nil and backpack:FindFirstChild("Knife") ~= nil
end

local function isLocalMurderer()
    local role = myRole()
    if role then return role == "Murderer" end
    return hasKnifeOn(LocalPlayer)
end

local function findMurdererPlayer()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and roleOf(player) == "Murderer" and not isDead(player) then
            return player
        end
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and hasKnifeOn(player) and not isDead(player) then
            return player
        end
    end
    return nil
end

-- A live round always has a murderer. If there is none, the round is over (or
-- the next one has not assigned roles yet), so the farm should just idle until
-- candy is visible again.
local function murdererExists()
    if isLocalMurderer() then return true end
    return findMurdererPlayer() ~= nil
end

local function planarDistance(a, b)
    local dx, dz = a.X - b.X, a.Z - b.Z
    return math.sqrt(dx * dx + dz * dz)
end

local function murdererPosition()
    if isLocalMurderer() then return nil end
    local killer = findMurdererPlayer()
    local char = killer and killer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    return hrp and hrp.Position or nil
end

local function candyIsSafeAt(obj, killerPos)
    if not obj then return false end
    if not killerPos then return true end

    -- Ignored when inside a 10-stud horizontal radius and within 10 studs
    -- above or below the murderer.
    local horizontal = planarDistance(obj.Position, killerPos)
    if horizontal > KILLER_IGNORE_RADIUS then return true end
    return math.abs(obj.Position.Y - killerPos.Y) > KILLER_IGNORE_HEIGHT
end

local function candyIsSafe(obj)
    return candyIsSafeAt(obj, murdererPosition())
end

-- ==================== CANDY SELECTION ====================
-- Intentionally simple: always walk to the nearest safe, available candy.
-- A stable per-object key breaks exact-distance ties, so two candies at the
-- same distance can never make the chooser flip back and forth.
local candyIds = setmetatable({}, { __mode = "k" })
local nextCandyId = 0

local function candyKey(obj)
    local id = candyIds[obj]
    if not id then
        nextCandyId = nextCandyId + 1
        id = nextCandyId
        candyIds[obj] = id
    end
    return id
end

local function selectBestPath(list)
    local root = getRoot()
    if not root then return nil end
    local origin = (hidden and hideSavedCF) and hideSavedCF.Position or root.Position
    local now = tick()
    local killerPos = murdererPosition()
    local best, bestDist, bestKey
    local soonestBlocked = math.huge

    for _, c in ipairs(list) do
        local obj = c.obj
        if isAvailable(obj) and candyIsSafeAt(obj, killerPos) then
            local blockedUntil = Candy.SkipUntil[obj]
            if blockedUntil and blockedUntil > now then
                if blockedUntil < soonestBlocked then
                    soonestBlocked = blockedUntil
                end
            else
                local pos = obj.Position
                local dist = (pos - origin).Magnitude
                local key = candyKey(obj)
                if not best
                    or dist < bestDist
                    or (dist == bestDist and key < bestKey) then
                    best = {
                        obj = obj,
                        pos = pos,
                        dist = dist,
                        key = key,
                    }
                    bestDist = dist
                    bestKey = key
                end
            end
        end
    end

    if not best then
        Candy.Plan = nil
        if soonestBlocked < math.huge then
            -- Every safe candy is cooling down after a failed attempt. Wait
            -- for the first one instead of diving under the map and back.
            return nil, math.max(0.05, soonestBlocked - now)
        end
        return nil
    end

    Candy.Plan = {
        first = best.obj,
        count = 1,
        distance = best.dist,
        route = { best.obj },
    }
    return best
end

local function markCandyFailure(obj)
    if not obj then return end
    local rec = Candy.Failures[obj]
    if not rec then
        rec = { count = 0 }
        Candy.Failures[obj] = rec
    end
    rec.count = rec.count + 1

    -- A real candy normally succeeds in one attempt. Exponential backoff stops
    -- a decorative/fake part (or a target the game keeps resetting) from being
    -- picked over and over, which is what made the farm look frozen.
    local cooldown = math.min(30, 0.6 * (2 ^ (rec.count - 1)))
    Candy.SkipUntil[obj] = tick() + cooldown
    dbg("candy failed", obj:GetFullName(), "attempts", rec.count, "cooldown", cooldown)
end

-- Kept for API compatibility with older callers.
local function selectNearest(list)
    return selectBestPath(list)
end

-- ==================== MOVEMENT / COLLECTION ====================
-- Each leg is a linear CFrame tween driven by Roblox's TweenService. The root
-- is anchored for the first 80% of the leg: that locks the vertical axis and
-- stops the humanoid/physics solver from snapping the character down every
-- frame, which is what made vertical movement jittery. For the final 20% the
-- root is unanchored and touch interest is fired as soon as the candy is close,
-- so the pickup can register before the tween even finishes. The original
-- gravity is always restored and there is no murderer avoidance; dangerous
-- candies are filtered by the picker.

local function moveTo(goalPos, speed, stopFn, touchPart)
    if Config.Noclip then
        enableNoclip()
        applyNoclip()
    end

    local root = getRoot()
    if not root then return false end

    speed = math.max(tonumber(speed) or 1, 1)
    local startPos = root.Position
    local initialDistance = (goalPos - startPos).Magnitude
    if initialDistance < 0.05 then return true end

    -- Only one CFrame tween may own the root. If an earlier move was
    -- interrupted without cleanup, cancel it so the two cannot fight.
    cancelTween()

    local hum = getHumanoid()
    local autoRotate = hum and hum.AutoRotate
    if hum then hum.AutoRotate = false end

    -- Anchor the root at the start. The tween still owns CFrame, but physics
    -- can no longer push the character up/down between render steps.
    root.Anchored = true

    local originalGravity = Workspace.Gravity
    local goalCF = CFrame.new(goalPos) * root.CFrame.Rotation
    local duration = math.max(initialDistance / speed, 0.01)

    Workspace.Gravity = 0
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    local ok, tween = pcall(function()
        return TweenService:Create(
            root,
            TweenInfo.new(
                duration,
                Enum.EasingStyle.Linear,
                Enum.EasingDirection.Out,
                0,
                false,
                0
            ),
            { CFrame = goalCF }
        )
    end)
    if not ok or not tween then
        Workspace.Gravity = originalGravity
        if root and root.Parent then root.Anchored = false end
        if hum and hum.Parent and autoRotate ~= nil then
            hum.AutoRotate = autoRotate
        end
        dbg("tween create failed:", tostring(tween))
        return false
    end

    local finished = false
    local completedConn = tween.Completed:Connect(function(state)
        if state == Enum.PlaybackState.Completed then
            finished = true
        end
    end)

    activeTween = tween
    tween:Play()

    local startedAt = tick()
    local deadline = startedAt + duration + 4
    local lastPos = startPos
    local lastProgressAt = startedAt
    local unanchorAt = math.clamp(tonumber(Config.MoveUnanchorAt) or 0.8, 0.1, 1)
    local earlyTouchDistance = math.max(tonumber(Config.EarlyTouchDistance) or 5, 1)
    local unanchoredEarly = false
    local lastTouchAt = 0

    while not finished do
        if not root.Parent then break end
        if not Candy.Enabled or not roundActive or not isAlive() then break end
        if activeTween ~= tween then break end
        if stopFn and stopFn() then break end
        if tick() > deadline then break end

        if Config.Noclip then applyNoclip() end

        local now = tick()
        local pos = root.Position
        local remaining = (goalPos - pos).Magnitude
        local progress = 1 - remaining / math.max(initialDistance, 0.001)

        if not unanchoredEarly and progress >= unanchorAt then
            unanchoredEarly = true
            if root.Anchored then root.Anchored = false end
            dbg("early unanchor at", math.floor(math.clamp(progress, 0, 1) * 100) .. "%")
        end

        -- Keep the vertical lock only until the unanchor point. Once released,
        -- never let the game or another script re-anchor the root mid-pickup.
        if unanchoredEarly then
            if root.Anchored then root.Anchored = false end
        elseif not root.Anchored then
            root.Anchored = true
        end

        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero

        -- Fire touch interest during the unanchored final approach. The candy
        -- can then register before the tween reaches its exact center, which
        -- removes the old end-of-leg pickup pause.
        if unanchoredEarly and touchPart and touchPart.Parent and now - lastTouchAt >= 0.05 then
            local touchDist = (touchPart.Position - pos).Magnitude
            if touchDist <= earlyTouchDistance then
                lastTouchAt = now
                fireTouch(root, touchPart)
            end
        end

        if (pos - lastPos).Magnitude > 0.005 then
            lastPos = pos
            lastProgressAt = now
        elseif now - lastProgressAt > 1.5 then
            -- The tween says it is playing but the character is not actually
            -- moving (game anchored/reset it). Fail fast so the picker can
            -- choose another candy instead of hanging on this one.
            dbg("move stalled", initialDistance, "studs")
            break
        end

        RunService.Heartbeat:Wait()
    end

    if not finished then
        pcall(function() tween:Cancel() end)
    end
    completedConn:Disconnect()
    if activeTween == tween then
        activeTween = nil
    end

    Workspace.Gravity = originalGravity

    if root and root.Parent then
        if finished then
            -- Finish exactly at the requested world position; a near-enough
            -- stop can leave the root outside a small collectible's touch box.
            root.CFrame = goalCF
        end
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        -- Hand the character back to physics before the pickup finisher.
        root.Anchored = false
    end

    if hum and hum.Parent and autoRotate ~= nil then
        hum.AutoRotate = autoRotate
    end
    return finished
end

local function collectCandy(target)
    if not target or not isAvailable(target.obj) then return false, "gone" end
    local root = getRoot()
    if not root then return false, "dead" end

    local obj = target.obj
    Candy.Busy   = true
    Candy.Target = target

    local stopFn = function()
        if not Candy.Enabled or not roundActive or not isAlive() then return true end
        if pollWaitingForTurn() then return true end
        if not isAvailable(obj) then return true end
        if not candyIsSafe(obj) then return true end
        return false
    end

    local reached = moveTo(obj.Position, Candy.TweenSpeed, stopFn, obj)

    -- Reliable pickup finisher: keep the unanchored root centered on the
    -- collectible briefly, with gravity temporarily disabled so it doesn't drift.
    if reached and Candy.Enabled and roundActive and isAlive() and isAvailable(obj) then
        local r = getRoot()
        if r and obj and obj.Parent then
            local previousGravity = Workspace.Gravity
            local touchOk = false
            local ok, err = pcall(function()
                Workspace.Gravity = 0
                r.AssemblyLinearVelocity = Vector3.zero
                r.AssemblyAngularVelocity = Vector3.zero

                local finishTime = math.clamp(tonumber(Config.PickupFinishTime) or 0.12, 0.02, 0.5)
                local touchUntil = tick() + finishTime
                repeat
                    if not Candy.Enabled or not roundActive or not isAlive() then break end
                    if not obj.Parent or not isAvailable(obj) then break end

                    -- Re-read Position in case the collectible moved between frames.
                    r.CFrame = CFrame.new(obj.Position) * r.CFrame.Rotation
                    r.AssemblyLinearVelocity = Vector3.zero
                    r.AssemblyAngularVelocity = Vector3.zero
                    fireTouch(r, obj)
                    RunService.Heartbeat:Wait()
                until tick() >= touchUntil

                touchOk = not isAvailable(obj)
            end)

            if r and r.Parent then
                r.AssemblyLinearVelocity = Vector3.zero
                r.AssemblyAngularVelocity = Vector3.zero
            end
            Workspace.Gravity = previousGravity
            if not ok then dbg("pickup touch error:", tostring(err)) end
            if not touchOk and isAvailable(obj) then
                fireTouch(r, obj)
                task.wait(0.05)
            end
        end
    end

    local got = not isAvailable(obj)
    Candy.Busy   = false
    Candy.Target = nil

    if got then
        Candy.Picked = Candy.Picked + 1
        Candy.SkipUntil[obj] = nil
        Candy.Failures[obj] = nil
        local guiCount = refreshCollectedFromGui()
        if not guiCount then
            Candy.Collected = math.max(Candy.Picked, Candy.ServerCount)
        end
        dbg("collected", Candy.Collected, "/", bagTarget(), "gui=", tostring(guiCount))
        return true, "collected"
    end

    -- Tell the caller why the attempt ended. Only a genuine movement failure
    -- gets a failure penalty; waiting/danger/round-end must not blacklist a
    -- perfectly good candy.
    if not Candy.Enabled then return false, "disabled" end
    if not roundActive then return false, "roundEnded" end
    if not isAlive() then return false, "dead" end
    if not obj.Parent then return false, "gone" end
    if not isAvailable(obj) then return true, "collected" end
    if pollWaitingForTurn() then return false, "waiting" end
    if not candyIsSafe(obj) then return false, "danger" end
    return false, "unreachable"
end

-- ==================== GUN / ROLE COMBAT ====================
local function hasKnife(player)
    player = player or LocalPlayer
    local char = player.Character
    if char and char:FindFirstChild("Knife") then return true end
    local backpack = player:FindFirstChild("Backpack")
    if not backpack and char then
        backpack = char:FindFirstChildOfClass("Backpack")
    end
    return backpack ~= nil and backpack:FindFirstChild("Knife") ~= nil
end

local function findKiller()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and roleOf(player) == "Murderer" and not isDead(player) then
            return player
        end
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and hasKnife(player) and not isDead(player) then
            return player
        end
    end
    return nil
end

local function getSheriff()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and roleOf(player) == "Sheriff" and not isDead(player) then
            return player
        end
    end
    return nil
end

local function findGunTool()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack and char then
        backpack = char:FindFirstChildOfClass("Backpack")
    end
    local function scan(container)
        if not container then return nil end
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("Tool") and child.Name:lower():find("gun") then
                return child
            end
        end
        return nil
    end
    return scan(char) or scan(backpack)
end

local function playerHasGun()
    return findGunTool() ~= nil
end

-- Any other player holding a gun (sheriff, or an innocent who picked one up).
-- Used as a fallback when role data is missing or stale, so combat still knows
-- who to fling for a gun drop.
local function playerHasGunTool(player)
    local char = player.Character
    if char and char:FindFirstChild("Gun") then return true end
    local containers = {}
    if char then table.insert(containers, char) end
    local backpack = player:FindFirstChild("Backpack")
    if not backpack and char then backpack = char:FindFirstChildOfClass("Backpack") end
    if backpack then table.insert(containers, backpack) end

    for _, container in ipairs(containers) do
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("Tool") and child.Name:lower():find("gun") then
                return true
            end
        end
    end
    return false
end

local function findGunHolder()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and not isDead(player) and playerHasGunTool(player) then
            return player
        end
    end
    return nil
end

local function equipGun()
    local char = LocalPlayer.Character
    if not char then return nil end
    local gun = findGunTool()
    if not gun then return nil end
    if gun.Parent == char then return gun end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end
    pcall(function() hum:EquipTool(gun) end)
    local t0 = tick()
    repeat
        task.wait(0.05)
        gun = findGunTool()
    until (gun and gun.Parent == char) or tick() - t0 > 1.5
    if gun and gun.Parent == char then return gun end
    return nil
end

local function getShootRemote(gun)
    if not gun then return nil end
    local shoot = gun:FindFirstChild("Shoot")
    if shoot and shoot:IsA("RemoteEvent") then return shoot end
    for _, child in ipairs(gun:GetDescendants()) do
        if child:IsA("RemoteEvent") and child.Name:lower() == "shoot" then
            return child
        end
    end
    return nil
end

local function getAimPosition(killer)
    local char = killer and killer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local head = char:FindFirstChild("Head")
    local part = head or hrp
    if not part then return nil end
    -- Direct aim only: no velocity prediction, so the shot goes exactly at the
    -- murderer's current position while we are synced right behind him.
    return part.Position
end

local function fireAt(killer, gun, immediate)
    gun = gun or equipGun()
    if not gun then return false end
    local remote = getShootRemote(gun)
    if not remote then
        warn("[shoot] gun has no Shoot remote")
        return false
    end

    local root = getRoot()
    if not root then return false end

    local aim = getAimPosition(killer)
    if not aim then return false end

    local attachment = root:FindFirstChild("GunRaycastAttachment")
    if not attachment and not immediate then
        local t0 = tick()
        repeat
            task.wait(0.03)
            attachment = root:FindFirstChild("GunRaycastAttachment")
        until attachment or tick() - t0 > 0.6
    end
    local origin = attachment and attachment.WorldCFrame or CFrame.new(root.Position + Vector3.new(0, 1, 0))

    local ok, err = pcall(function()
        remote:FireServer(origin, CFrame.new(aim))
    end)
    if not ok then
        warn("[shoot] FireServer failed: " .. tostring(err))
        return false
    end
    return true
end

local function killerDown(killer)
    if not killer or not killer.Parent then return true end
    local char = killer.Character
    if not char then return true end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum == nil or hum.Health <= 0
end

local function behindKillerCF(killer)
    local char = killer and killer.Character
    local killerRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not killerRoot then return nil end

    -- Use a flattened look vector so a murderer looking up/down does not drag
    -- the sync point above or below him.
    local look = killerRoot.CFrame.LookVector
    local flat = Vector3.new(look.X, 0, look.Z)
    if flat.Magnitude < 0.001 then
        flat = Vector3.new(0, 0, 1)
    else
        flat = flat.Unit
    end

    local distance = tonumber(Config.SyncBehindDistance) or 3
    local height = tonumber(Config.SyncBehindHeight) or 1
    local behind = killerRoot.Position - flat * distance + Vector3.new(0, height, 0)
    return CFrame.new(behind, killerRoot.Position)
end

local function syncBehindKiller(killer, root, physicsTarget)
    local cf = behindKillerCF(killer)
    if not cf then return false end
    if root.Anchored then root.Anchored = false end
    root.CFrame = cf
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    if physicsTarget then
        -- Same technique as the fling loop: reapply the hidden physics
        -- representation every step. Setting it once is not enough because the
        -- server can still be using the pre-sync position when the shot lands.
        setPhysicsRep(root, physicsTarget)
    end
    return true
end

local function teleportShoot(silent)
    if isShooting then return false, false end
    if tick() - lastTeleportShot < Config.TeleportShootCooldown then return false, false end
    if not isAlive() then return false, false end
    if not playerHasGun() then
        if not silent then print("[candy] no gun") end
        return false, false
    end

    local killer = findKiller()
    if not killer or not killer.Character then
        if not silent then print("[candy] no murderer") end
        return false, false
    end

    local root = getRoot()
    local killerRoot = killer.Character:FindFirstChild("HumanoidRootPart")
    if not root or not killerRoot then return false, false end

    if hidden then unhideCharacter() end

    local gun = equipGun()
    if not gun then return false, false end

    local hum = getHumanoid()
    local autoRotate = hum and hum.AutoRotate
    if hum then hum.AutoRotate = false end

    isShooting = true
    lastTeleportShot = tick()

    local originalCF = root.CFrame
    local saved = {}
    local char = LocalPlayer.Character
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            saved[part] = part.CanCollide
            part.CanCollide = false
        end
    end

    local firedAny = false
    local hit = false
    local ok, err = pcall(function()
        local killerHead = killer.Character and killer.Character:FindFirstChild("Head")
        if not killerHead then killerHead = killerRoot end

        local holdTime = math.clamp(tonumber(Config.SyncHoldTime) or 1.0, 0.2, 5)
        local fireAtTime = math.clamp(
            tonumber(Config.SyncFireAt) or (holdTime * 0.5),
            0.05,
            math.max(holdTime - 0.05, 0.05)
        )
        local shots = math.clamp(tonumber(Config.SyncVolleyShots) or 4, 1, 20)
        local interval = math.clamp(tonumber(Config.SyncShotInterval) or 0.08, 0.02, 0.5)

        -- Warm up the raycast attachment before the hold. Waiting for it at the
        -- midpoint would interrupt the sync loop and send the shot late.
        local attachment = root:FindFirstChild("GunRaycastAttachment")
        if not attachment then
            local warmup = tick()
            repeat
                task.wait(0.02)
                attachment = root:FindFirstChild("GunRaycastAttachment")
            until attachment or tick() - warmup > 0.4
        end

        -- Initial sync, then hold the hidden server representation behind him
        -- for the whole window. The first shot is deliberately delayed until
        -- the middle of that window.
        if not syncBehindKiller(killer, root, killerHead) then return end
        local started = tick()
        local shotsFired = 0
        local lastShotAt = -math.huge

        while true do
            if not Candy.Enabled or not roundActive or not isAlive() then break end

            local down = killerDown(killer)
            if down then hit = true end

            if not syncBehindKiller(killer, root, killerHead) then break end

            local now = tick()
            local elapsed = now - started
            if not down and shotsFired < shots and elapsed >= fireAtTime
                and (shotsFired == 0 or now - lastShotAt >= interval) then
                -- One extra network step with the behind CFrame (and the hidden
                -- physics rep) after the midpoint has been reached.
                RunService.Heartbeat:Wait()
                if not Candy.Enabled or not roundActive or not isAlive() then break end

                if killerDown(killer) then
                    hit = true
                else
                    if not syncBehindKiller(killer, root, killerHead) then break end
                    if fireAt(killer, gun, true) then firedAny = true end
                    shotsFired = shotsFired + 1
                    lastShotAt = tick()
                end
            end

            if tick() - started >= holdTime then break end
            RunService.Heartbeat:Wait()
        end

        if killerDown(killer) then hit = true end
    end)
    if not ok then warn("[teleportShoot] " .. tostring(err)) end

    if root.Parent then
        root.CFrame = originalCF
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
    clearPhysicsRep(root)
    for part, coll in pairs(saved) do
        if part and part.Parent then part.CanCollide = coll end
    end
    if hum and hum.Parent and autoRotate ~= nil then
        hum.AutoRotate = autoRotate
    end

    isShooting = false
    dbg("teleportShoot hit=", tostring(hit), "fired=", tostring(firedAny))
    return hit, firedAny
end

-- ==================== DROPPED GUN PICKUP ====================
local function isDroppedGun(obj)
    if obj:IsA("BasePart") and obj.Name == "GunDrop" then return true end
    if obj:IsA("Tool") and obj.Name:lower():find("gun") then
        local p = obj.Parent
        if p == LocalPlayer.Character then return false end
        if p and p:IsA("Model") and playerFromCharacter(p) then return false end
        if p and p:IsA("Backpack") then return false end
        return true
    end
    return false
end

local function gunPos(obj)
    if obj:IsA("BasePart") then return obj.Position end
    local handle = obj:FindFirstChild("Handle")
    if handle and handle:IsA("BasePart") then return handle.Position end
    local any = obj:FindFirstChildWhichIsA("BasePart")
    return any and any.Position or nil
end

local function findNearestGun(anyDistance)
    local root = getRoot()
    if not root then return nil end
    local nearest, best = nil, math.huge

    local function consider(obj)
        if not isDroppedGun(obj) then return end
        local pos = gunPos(obj)
        if not pos then return end
        local d = (pos - root.Position).Magnitude
        if d < best then
            best = d
            nearest = { obj = obj, pos = pos, dist = d }
        end
    end

    local function scan(container, depth)
        for _, obj in ipairs(container:GetChildren()) do
            consider(obj)
            if depth > 0 and (obj:IsA("Model") or obj:IsA("Folder")) then
                scan(obj, depth - 1)
            end
        end
    end
    scan(Workspace, 3)

    if nearest and (anyDistance or nearest.dist <= GUN_DISTANCE) then return nearest end
    return nil
end

local function waitForGun(timeout)
    local t0 = tick()
    while tick() - t0 < (timeout or 2) do
        if playerHasGun() then return true end
        task.wait(0.1)
    end
    return playerHasGun()
end

local function waitForGunDrop(timeout)
    local t0 = tick()
    while tick() - t0 < (timeout or 5) do
        if not Candy.Enabled or not roundActive or not isAlive() then return false end
        if findNearestGun(true) then return true end
        task.wait(0.2)
    end
    return false
end

local function teleportToGun(silent)
    if isTeleporting or isShooting then return false end
    if playerHasGun() then return true end

    local info = findNearestGun(true)
    if not info then
        if not silent then print("[candy] no dropped gun") end
        return false
    end

    local root = getRoot()
    if not root then return false end

    local handle
    if info.obj:IsA("BasePart") then
        handle = info.obj
    else
        handle = info.obj:FindFirstChild("Handle") or info.obj:FindFirstChildWhichIsA("BasePart")
    end

    isTeleporting = true
    local originalCF = root.CFrame

    -- Try the remote touch first; if that does not take, teleport straight onto
    -- the gun and keep re-touching it. The character has noclip, so jumping any
    -- distance to the drop is safe and much faster than running to it.
    fireTouch(root, handle)
    task.wait(0.15)

    if not playerHasGun() then
        local t0 = tick()
        while tick() - t0 < 1.2 and not playerHasGun() do
            if not Candy.Enabled or not roundActive or not isAlive() then break end

            -- Re-scan so a gun that is still falling is tracked to its new spot.
            local fresh = findNearestGun(true)
            local pos = fresh and fresh.pos or info.pos
            local h = handle
            if fresh and fresh.obj ~= info.obj then
                if fresh.obj:IsA("BasePart") then
                    h = fresh.obj
                else
                    h = fresh.obj:FindFirstChild("Handle")
                        or fresh.obj:FindFirstChildWhichIsA("BasePart")
                end
            end

            local rr = getRoot()
            if rr then
                rr.CFrame = CFrame.new(pos + Vector3.new(0, 1.5, 0))
                rr.AssemblyLinearVelocity = Vector3.zero
                rr.AssemblyAngularVelocity = Vector3.zero
                if h then fireTouch(rr, h) end
            end
            task.wait(0.05)
        end
    end

    isTeleporting = false
    local got = playerHasGun()

    if not got then
        local r = getRoot()
        if r then r.CFrame = originalCF end
    else
        equipGun()
    end

    dbg("teleportToGun got=", tostring(got))
    return got
end

-- ==================== FLING ====================
local FlingEnabled = false
local flingLoop, flingSpinLoop
local flingTarget, flingOriginalCF, flingStartPos
local flingBodySaved = {}

local function setFlingBody(enabled)
    local char = LocalPlayer.Character
    if not char then return end
    if enabled then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and flingBodySaved[part] == nil then
                flingBodySaved[part] = { CanCollide = part.CanCollide, Massless = part.Massless }
                part.CanCollide = false
                part.Massless = true
            end
        end
    else
        for part, state in pairs(flingBodySaved) do
            if part and part.Parent then
                part.CanCollide = state.CanCollide
                part.Massless = state.Massless
            end
        end
        table.clear(flingBodySaved)
    end
end

local function stopFling()
    if flingLoop then flingLoop:Disconnect(); flingLoop = nil end
    if flingSpinLoop then flingSpinLoop:Disconnect(); flingSpinLoop = nil end

    local root = getRoot()
    if root then
        root.AssemblyAngularVelocity = Vector3.zero
        root.AssemblyLinearVelocity = Vector3.zero
        if flingOriginalCF then root.CFrame = flingOriginalCF end
        clearPhysicsRep(root)
    end

    setFlingBody(false)
    local hum = getHumanoid()
    if hum then
        hum.PlatformStand = false
        hum.AutoRotate = true
    end

    flingTarget = nil
    flingOriginalCF = nil
    flingStartPos = nil
    FlingEnabled = false
end

local function startFling(target)
    if not target or not target.Character then return false end
    local root = getRoot()
    local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
    if not root or not targetRoot then return false end

    if FlingEnabled then stopFling() end
    flingTarget = target
    flingStartPos = targetRoot.Position
    flingOriginalCF = root.CFrame
    FlingEnabled = true
    setFlingBody(true)

    flingLoop = RunService.Heartbeat:Connect(function()
        if not FlingEnabled or not Candy.Enabled or not roundActive then
            stopFling()
            return
        end
        local myRoot = getRoot()
        if not myRoot then stopFling(); return end
        if not flingTarget or not flingTarget.Character then stopFling(); return end

        local targetChar = flingTarget.Character
        local tr = targetChar:FindFirstChild("HumanoidRootPart")
        local th = targetChar:FindFirstChild("Head")
        local hum = targetChar:FindFirstChildOfClass("Humanoid")
        if not tr or not hum or hum.Health <= 0 then stopFling(); return end

        myRoot.CFrame = tr.CFrame
        if th then setPhysicsRep(myRoot, th) end
    end)

    flingSpinLoop = RunService.Heartbeat:Connect(function()
        if not FlingEnabled then return end
        local myRoot = getRoot()
        if not myRoot then return end
        myRoot.AssemblyAngularVelocity = Vector3.new(0, 99999, 0)
        task.wait(0.15)
        if not FlingEnabled then return end
        myRoot.AssemblyAngularVelocity = Vector3.zero
        task.wait(0.08)
    end)

    return true
end

local function flingPlayer(target, timeout)
    if not target or not target.Character then return false end
    if FlingEnabled then stopFling() end

    local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return false end
    local startPos = targetRoot.Position

    if not startFling(target) then return false end

    local t0 = tick()
    local displaced = false
    while tick() - t0 < (timeout or 2) do
        task.wait(0.05)
        if not Candy.Enabled or not roundActive or not isAlive() then break end
        local char = target.Character
        local tr = char and char:FindFirstChild("HumanoidRootPart")
        if not tr then displaced = true; break end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then displaced = true; break end
        if (tr.Position - startPos).Magnitude >= 5 or tr.AssemblyLinearVelocity.Magnitude > 100 then
            displaced = true
            break
        end
    end

    stopFling()
    return displaced
end

-- ==================== WAITING FOR YOUR TURN ====================
-- Verified in the running game: this message is not a TextLabel. It is the
-- ImageLabel MainGUI.Game.Waiting, shown with image asset 189761558 while the
-- player waits in the lobby. Asset 304416585 is the map-loading image and must
-- not count as "waiting for your turn".
local WAITING_IMAGE_ID = "189761558"

local Waiting = {
    Active      = false,
    Handled     = false,
    LastCheck   = 0,
    LastAttempt = 0,
    ClearedAt   = 0,
}

local function findWaitingOverlay()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    local main = pg and pg:FindFirstChild("MainGUI")
    local gameGui = main and main:FindFirstChild("Game")
    local overlay = gameGui and gameGui:FindFirstChild("Waiting")
    if overlay and overlay:IsA("ImageLabel") then
        return overlay
    end
    return nil
end

local function isWaitingTextVisible()
    local overlay = findWaitingOverlay()
    if not overlay or not overlay.Visible then return false end

    local node = overlay.Parent
    while node do
        if node:IsA("GuiObject") and not node.Visible then return false end
        if node:IsA("LayerCollector") and not node.Enabled then return false end
        node = node.Parent
    end

    local image = tostring(overlay.Image or "")
    return image:find(WAITING_IMAGE_ID, 1, true) ~= nil
end

pollWaitingForTurn = function()
    local now = tick()
    if now - Waiting.LastCheck < 0.12 then
        return Waiting.Active
    end
    Waiting.LastCheck = now

    local visible = isWaitingTextVisible()
    if visible then
        if not Waiting.Active then
            if Waiting.ClearedAt == 0 or now - Waiting.ClearedAt >= 0.5 then
                -- New waiting period: allow one fresh fling.
                Waiting.Handled = false
                Waiting.LastAttempt = 0
            end
            dbg("WAITING FOR YOUR TURN detected")
        end
        Waiting.Active = true
        Waiting.ClearedAt = 0
    elseif Waiting.Active then
        Waiting.Active = false
        Waiting.ClearedAt = now
        dbg("WAITING FOR YOUR TURN cleared")
    end
    return Waiting.Active
end

local function flingMurdererForWaiting()
    if not Candy.Enabled or not roundActive or not isAlive() then return false end
    local killer = findKiller() or findMurdererPlayer()
    if not killer or not killer.Character then return false end

    unhideCharacter()
    local ok, displaced = pcall(flingPlayer, killer, 2.0)
    if not ok then
        warn("[waiting] fling failed: " .. tostring(displaced))
        return false
    end
    dbg("waiting fling", killer.Name, "displaced=", tostring(displaced))
    return displaced == true
end

handleWaitingForTurn = function()
    if not Waiting.Handled and tick() - Waiting.LastAttempt >= 2.5 then
        Waiting.LastAttempt = tick()
        if flingMurdererForWaiting() then
            Waiting.Handled = true
        end
    end

    cancelTween()
    Candy.Busy = false
    Candy.Target = nil
    if Candy.Enabled and Config.HideUnderMap and isAlive() and not Candy.Hidden then
        hideCharacter()
    end
end

-- ==================== KNIFE SWEEP ====================
local hitboxSaved = {}

local function setHitbox(player, size)
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if not hitboxSaved[player] then
        hitboxSaved[player] = {
            Size = hrp.Size,
            Transparency = hrp.Transparency,
            CanCollide = hrp.CanCollide,
        }
    end

    if size then
        hrp.Size = Vector3.new(size, size, size)
        hrp.Transparency = 0.7
        hrp.CanCollide = false
    else
        local old = hitboxSaved[player]
        if old then
            hrp.Size = old.Size
            hrp.Transparency = old.Transparency
            hrp.CanCollide = old.CanCollide
        end
        hitboxSaved[player] = nil
    end
end

local function restoreHitboxes()
    for player in pairs(hitboxSaved) do
        if player.Parent then setHitbox(player, nil) end
    end
    table.clear(hitboxSaved)
end

local function getKnife()
    local char = LocalPlayer.Character
    if not char then return nil end
    local knife = char:FindFirstChild("Knife")
    if knife then return knife end
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then backpack = char:FindFirstChildOfClass("Backpack") end
    knife = backpack and backpack:FindFirstChild("Knife")
    if not knife then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        pcall(function() hum:EquipTool(knife) end)
        local t0 = tick()
        repeat
            task.wait(0.05)
            knife = char:FindFirstChild("Knife")
        until knife or tick() - t0 > 1.5
    end
    return knife
end

local function knifeSweep()
    if not isAlive() then return 0 end
    if myRole() ~= "Murderer" and not hasKnife(LocalPlayer) then return 0 end

    local knife = getKnife()
    if not knife then
        local t0 = tick()
        while tick() - t0 < 2 and not knife do
            task.wait(0.15)
            knife = getKnife()
        end
    end
    if not knife then return 0 end

    local events = knife:FindFirstChild("Events")
    local touched = events and events:FindFirstChild(KNIFE_EVENT)
    if not touched or not touched:IsA("RemoteEvent") then
        warn("[knife] " .. KNIFE_EVENT .. " missing")
        return 0
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then setHitbox(p, HITBOX_SIZE) end
    end
    task.wait(0.12)

    -- Start the same slash the real KnifeClient starts, then feed the server a
    -- touched part for every player. The direct HandleTouched calls are what do
    -- the killing; KnifeStabbed just opens the normal stab window.
    local stabbed = events:FindFirstChild("KnifeStabbed")
    if stabbed and stabbed:IsA("RemoteEvent") then
        pcall(function() stabbed:FireServer() end)
        task.wait(0.06)
    end

    local killed = 0
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and hrp then
                pcall(function() touched:FireServer(hrp) end)
                task.wait(0.04)
            end
        end
    end

    task.wait(0.25)
    restoreHitboxes()

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and isDead(p) then killed = killed + 1 end
    end
    dbg("knifeSweep killed=", killed)
    return killed
end

-- Fire a synced volley at the murderer. If none of the shots registered,
-- drop underground, idle for MissRetryDelay seconds, then let the combat loop
-- bring the character back up and try again.
local function shootKillerWithMissRetry()
    if not Candy.Enabled or not roundActive or not isAlive() then return false end
    if not playerHasGun() then return false end

    local hit, fired = teleportShoot(true)
    if not fired then return false end
    if hit or not murdererExists() then return true end

    cancelTween()
    hideCharacter()
    dbg("shot missed; hiding for", Config.MissRetryDelay, "seconds")

    local retryAt = tick() + math.max(tonumber(Config.MissRetryDelay) or 4, 0.5)
    while Candy.Enabled and roundActive and isAlive() and tick() < retryAt do
        if not murdererExists() then break end
        if pollWaitingForTurn() then
            handleWaitingForTurn()
            break
        end
        task.wait(0.1)
    end

    if Candy.Enabled and roundActive and isAlive()
        and murdererExists() and Candy.Hidden then
        unhideCharacter()
    end
    return false
end

-- ==================== COMBAT PHASE ====================
local function combatPhase()
    if not Config.AutoCombat then return false end
    if not Candy.Enabled or not roundActive or not isAlive() then return false end
    if not bagFull() then return false end

    unhideCharacter()
    refreshPlayerData()
    local role = myRole()
    if not role then role = waitForRole(3) end
    if not isAlive() or not roundActive then return false end

    dbg("combat role=", tostring(role))

    -- Murderer: hitboxes to 500, equip knife, remote slash everyone.
    if role == "Murderer" or hasKnife(LocalPlayer) then
        knifeSweep()
        return true
    end

    -- Sheriff (or an innocent who already picked up a gun).
    if playerHasGun() then
        equipGun()
        shootKillerWithMissRetry()
        return true
    end

    -- Innocent: fling whoever is carrying a gun (the sheriff, or an armed
    -- innocent) until it drops, take it, then teleport-shoot the murderer.
    if role == "Innocent" or role == nil then
        local holder = getSheriff() or findGunHolder()
        if holder then
            for attempt = 1, 2 do
                if not Candy.Enabled or not roundActive or not isAlive() then return false end
                if not playerHasGun() and waitForGunDrop(0.2) then break end
                dbg("flinging gun holder", holder.Name, "attempt", attempt)
                flingPlayer(holder, 2.0)
                if waitForGunDrop(4) then break end
            end
        end
    end

    -- If the carrier died earlier (or the fling was enough), grab the drop.
    if not playerHasGun() then
        waitForGunDrop(4)
    end
    if not playerHasGun() then
        teleportToGun(true)
        waitForGun(1.5)
    end

    if playerHasGun() and isAlive() and roundActive then
        equipGun()
        shootKillerWithMissRetry()
        return true
    end
    return false
end

-- ==================== FARM ====================
local farmRound
farmRound = function()
    local idleSince = tick()
    while Candy.Enabled and roundActive and isAlive() do
        if pollWaitingForTurn() then
            handleWaitingForTurn()
            task.wait(0.1)
            continue
        end

        -- No murderer means the round is effectively over. Stay hidden and
        -- do nothing until a candy is actually visible again.
        if not murdererExists() then
            local list = findCandies(false)
            if #list == 0 then
                if not Candy.Hidden and tick() - idleSince > 0.4 then
                    hideCharacter()
                end
                task.wait(0.15)
                continue
            end
        end

        if bagFull() then
            unhideCharacter()
            return "full"
        end

        local list = findCandies(false)
        local target, waitHint = selectBestPath(list)
        if not target then
            if waitHint then
                -- All currently safe candies are cooling down after failed
                -- pickups. Stay on the surface and retry when the first one
                -- is allowed again instead of hiding/unhiding repeatedly.
                task.wait(math.min(waitHint, 0.25))
            else
                -- No safe candy: go under the map and keep polling. As soon as
                -- a safe candy appears we pop up above it and start moving.
                if not Candy.Hidden and tick() - idleSince > 0.4 then
                    hideCharacter()
                end
                task.wait(0.1)
            end
        else
            idleSince = tick()
            if Candy.Hidden then
                unhideForCandy(target)
            end
            local got, reason = collectCandy(target)
            if not got then
                if reason == "unreachable" then
                    markCandyFailure(target.obj)
                elseif reason == "gone" then
                    -- Someone else took it; just rescan on the next loop.
                elseif reason ~= "disabled" and reason ~= "roundEnded" then
                    Candy.SkipUntil[target.obj] = math.max(
                        Candy.SkipUntil[target.obj] or 0,
                        tick() + 0.4
                    )
                end
                Candy.LastScan = 0
                task.wait(0.04)
            end
        end
    end
    return roundActive and "stopped" or "roundEnded"
end

-- Once the bag is full, keep attempting combat until the round ends, the
-- murderer is gone, or the farm is toggled off. Without this the worker tried
-- combat exactly once and then idled until the round ended, which is what made
-- it look stuck at 50 candies.
local function combatUntilRoundEnds()
    if isLocalMurderer() then
        local ok, err = pcall(combatPhase)
        if not ok then warn("[combat] " .. tostring(err)) end
        return
    end

    local lastTry = 0
    while Candy.Enabled and roundActive and isAlive() and bagFull() do
        if pollWaitingForTurn() then
            handleWaitingForTurn()
            task.wait(0.15)
            continue
        end
        if not murdererExists() then break end

        if tick() - lastTry >= 1.5 then
            lastTry = tick()
            local ok, err = pcall(combatPhase)
            if not ok then warn("[combat] " .. tostring(err)) end
        end
        task.wait(0.2)
    end
end

-- ==================== DEATH REVENGE ====================
-- If we die while the farm is running with an unfinished bag, the round is
-- normally a lost cause. After the character respawns, fling the murderer
-- repeatedly until the round ends. The handler is cancelled automatically when
-- a new round starts, the farm is disabled, or a newer death replaces it.
local revengeToken = 0

local function revengeAfterRespawn(serial, token)
    while Candy.Enabled and roundActive and roundSerial == serial and not isAlive() do
        if token ~= revengeToken then return end
        task.wait(0.2)
    end
    if token ~= revengeToken then return end
    if not Candy.Enabled or not roundActive or roundSerial ~= serial or not isAlive() then return end
    if bagFull() then return end

    unhideCharacter()
    dbg("respawned after a farm death; flinging murderer")

    local attempts = 0
    while attempts < 3 do
        if token ~= revengeToken then return end
        if not Candy.Enabled or not roundActive or roundSerial ~= serial or not isAlive() then return end
        if not murdererExists() then break end

        local killer = findKiller() or findMurdererPlayer()
        if not killer then break end

        attempts = attempts + 1
        unhideCharacter()
        local ok, displaced = pcall(flingPlayer, killer, 2.5)
        dbg("revenge fling", killer.Name, "attempt", attempts, "displaced=", tostring(displaced))
        if not ok then break end
        task.wait(0.3)
    end
end

local deathWatchHum = nil
local deathWatchGeneration = 0
local deathWatchCharConn = nil

local function onLocalDeath()
    if not Candy.Enabled or not roundActive then return end
    if bagFull() then return end

    revengeToken = revengeToken + 1
    local token = revengeToken
    local serial = roundSerial
    dbg("death detected; waiting for respawn to fling the murderer")
    task.spawn(function()
        revengeAfterRespawn(serial, token)
    end)
end

local function attachDeathWatch(char)
    deathWatchGeneration = deathWatchGeneration + 1
    local generation = deathWatchGeneration

    if deathWatchHum then
        pcall(function() deathWatchHum:Disconnect() end)
        deathWatchHum = nil
    end
    if not char then return end

    local function connect(hum)
        if generation ~= deathWatchGeneration then return end
        if LocalPlayer.Character ~= char then return end
        deathWatchHum = hum.Died:Connect(onLocalDeath)
    end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        connect(hum)
    else
        task.spawn(function()
            local waited = char:WaitForChild("Humanoid", 5)
            if waited then connect(waited) end
        end)
    end
end

deathWatchCharConn = LocalPlayer.CharacterAdded:Connect(attachDeathWatch)
if LocalPlayer.Character then attachDeathWatch(LocalPlayer.Character) end

-- After a kick rejoin, the queued loader leaves a one-shot intent. If the same
-- round is still live and the murderer is alive, fling him before the normal
-- worker starts. If the round has already ended, return and let the worker
-- wait for the next round normally.
local function runRejoinKickRevenge()
    if not Candy.Enabled then return end
    dbg("rejoin revenge: checking the rejoined server")

    -- Only look for the round that was already running. Ten seconds is enough
    -- for the timer/role data to replicate without waiting through the whole
    -- intermission and accidentally flinging the next round's murderer.
    local deadline = tick() + 10
    while tick() < deadline do
        if not Candy.Enabled then return end

        if isAlive() then
            if not roundActive then
                detectActiveRound()
                if not roundActive and not myRole() then
                    waitForRole(1)
                end
            end

            if roundActive then
                -- If the timer says this is a freshly started round, do not
                -- fling its murderer: the round we were kicked from is over,
                -- so just wait for this one like normal.
                if roundStartTime > 0 and tick() - roundStartTime < 4 then
                    dbg("rejoin revenge: a new round started; waiting instead")
                    return
                end

                -- The round may have just started replicating, so give the
                -- role/knife data a few seconds before deciding the murderer
                -- is gone.
                local killer = nil
                local killerWaitUntil = tick() + 4
                repeat
                    killer = findKiller() or findMurdererPlayer()
                    if killer and not isDead(killer) then break end
                    if not myRole() then waitForRole(1) end
                    task.wait(0.4)
                until tick() >= killerWaitUntil

                if not killer or isDead(killer) then
                    dbg("rejoin revenge: no living murderer in the active round")
                    return
                end

                -- Let the character, role data and round timer settle after
                -- the join before starting the fling.
                task.wait(0.5)

                local attempts = 0
                while attempts < 3 and Candy.Enabled and roundActive and isAlive() do
                    killer = findKiller() or findMurdererPlayer()
                    if not killer or isDead(killer) then break end

                    attempts = attempts + 1
                    unhideCharacter()
                    local ok, displaced = pcall(flingPlayer, killer, 2.5)
                    dbg("rejoin revenge fling", killer.Name, "attempt", attempts, "displaced=", tostring(displaced))
                    if not ok then break end
                    task.wait(0.3)
                end
                return
            end
        end

        task.wait(0.5)
    end

    dbg("rejoin revenge: no live round after the rejoin")
end

-- ==================== WORKER ====================
local function resetForRound()
    Candy.Picked = 0
    Candy.ServerCount = 0
    Candy.Collected = 0
    Candy.GuiCount = 0
    Candy.GuiReadyAt = tick() + 0.8
    Candy.Cache = {}
    Candy.LastScan = 0
    Candy.Busy = false
    Candy.Target = nil
    clearCandyMemory()
end

local function worker(id)
    if Candy.ActiveWorker and Candy.ActiveWorker ~= id then return end
    Candy.ActiveWorker = id
    Candy.Running = true

    if pendingRejoinKickRevenge then
        pendingRejoinKickRevenge = false
        local ok, err = pcall(runRejoinKickRevenge)
        if not ok then warn("[rejoin] revenge failed: " .. tostring(err)) end
    end

    while Candy.Enabled and Candy.ActiveWorker == id do
        if not roundActive then
            detectActiveRound()
        end

        if not roundActive then
            -- Idle between rounds/lobby: stay hidden too, still without anchoring.
            if Candy.Enabled and isAlive() then
                hideCharacter()
            end
            task.wait(0.25)
        else
            local serial = roundSerial

            -- Round start: hide under the map while we wait for a role/candy.
            if Candy.Enabled and isAlive() then
                hideCharacter()
            end

            -- Make sure we have a role before doing anything.
            if not myRole() then
                waitForRole(3)
            end

            if Candy.Enabled and roundActive and roundSerial == serial then
                resetForRound()
                Candy.RoundSerial = serial

                -- Wait for a living character (do not move an anchored/dead one).
                while Candy.Enabled and roundActive and roundSerial == serial and not isAlive() do
                    unhideCharacter()
                    task.wait(0.25)
                end

                if Candy.Enabled and roundActive and roundSerial == serial and isAlive() then
                    -- No delay: farmRound starts as soon as a candy is visible.
                    local ok, status = xpcall(farmRound, function(err)
                        return tostring(err) .. "\n" .. debug.traceback("", 2)
                    end)
                    if not ok then
                        warn("[farm] " .. tostring(status))
                        Candy.Busy = false
                        Candy.Target = nil
                    else
                        dbg("farm ended:", tostring(status), Candy.Collected .. "/" .. tostring(bagTarget()))
                    end

                    if Candy.Enabled and roundActive and roundSerial == serial
                        and isAlive() and bagFull() then
                        local okCombat, err = pcall(combatUntilRoundEnds)
                        if not okCombat then warn("[combat] " .. tostring(err)) end
                    end

                    -- After collecting/combat, idle until the round ends.
                    if Candy.Enabled and roundActive and roundSerial == serial and isAlive() then
                        hideCharacter()
                    end
                end
            end

            -- Wait for the round to end before starting another one.
            local endedAt = tick()
            while Candy.Enabled and roundActive and roundSerial == serial do
                local t = readTimer()
                if t and t <= 0 and tick() - endedAt > 1 then
                    markRoundEnd("timer")
                    break
                end
                task.wait(0.25)
            end
        end
    end

    if Candy.ActiveWorker == id then
        cancelTween()
        stopFling()
        restoreHitboxes()
        Candy.Running = false
        Candy.ActiveWorker = nil
        Candy.Busy = false
        Candy.Target = nil
        dbg("worker stopped")
    end
end

-- ==================== CHARACTER RELEASE / TOGGLE ====================
local function releaseCharacter()
    unhideCharacter()
    cancelTween()
    stopFling()
    restoreHitboxes()

    local root = getRoot()
    if root then
        root.Anchored = false
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        clearPhysicsRep(root)
    end

    local hum = getHumanoid()
    if hum then
        hum.PlatformStand = false
        hum.AutoRotate = true
        hum.CameraOffset = Vector3.zero
    end
end

local function toggleCandy(state)
    state = not not state
    if state == Candy.Enabled then
        -- Re-assert the released state; this also fixes a root left anchored by
        -- an older version of the script.
        if not state then
            releaseCharacter()
            disableNoclip()
            disableAnimationLock()
        else
            enableNoclip()
            enableAnimationLock()
        end
        return
    end

    Candy.Enabled = state
    runSerial = runSerial + 1
    local id = runSerial

    if state then
        releaseCharacter()
        enableNoclip()
        enableAnimationLock()
        clearCandyMemory()
        Candy.Running = true
        Candy.ActiveWorker = id
        task.spawn(function() worker(id) end)
        print("[AutoCandyFarm] enabled — waiting for round start")
    else
        Candy.ActiveWorker = nil
        Candy.Running = false
        Config.Armed = false
        Candy.Busy = false
        Candy.Target = nil
        revengeToken = revengeToken + 1
        clearCandyMemory()
        releaseCharacter()
        disableNoclip()
        disableAnimationLock()
        print("[AutoCandyFarm] disabled")
    end
end

-- ==================== AUTO REJOIN / SERVER HOP ====================
-- GuiService.ErrorMessageChanged fires when Roblox shows a disconnect/kick
-- error. TeleportService still works for a short window while that message is
-- up, so reconnect as soon as the message changes.
local autoRejoinConnection = nil
local autoRejoinStarted = false
-- Register a loader for the next teleport. The queued code downloads this
-- script from the public URL after the teleport lands on the new server, then
-- runs it normally, so AutoStart brings the farm back up without a keypress.
-- `intent` is a one-shot table read by the new copy; for kick rejoins it says
-- the player was farming, which enables the "fling the murderer if the same
-- round is still live" step.
local function queueReexecute(intent)
    if not Config.QueueReexecute then return false end
    local url = tostring(Config.ReexecuteUrl or "")
    if url == "" then return false end

    local env = getgenv()
    local queue = env.queue_on_teleport or env.queueonteleport or env.queue_on_tp or env.queueontp
    if type(queue) ~= "function" then
        dbg("re-execution queue unavailable")
        return false
    end

    local intentCode = "nil"
    if type(intent) == "table" then
        local jobId = tostring(intent.jobId or game.JobId or "")
        intentCode = string.format(
            "{ kick = %s, farming = %s, jobId = %q, at = %d }",
            tostring(intent.kick == true),
            tostring(intent.farming == true),
            jobId,
            os.time()
        )
    end

    local loader = string.format([[
local url = %q
local source
for _ = 1, 8 do
    local ok, body = pcall(function() return game:HttpGet(url) end)
    if ok and type(body) == "string" and #body > 0 then
        source = body
        break
    end
    task.wait(2)
end
if source then
    getgenv().__mm2candy_rejoin = %s
    local fn, err = loadstring(source)
    if fn then
        fn()
    else
        warn("[AutoCandyFarm] re-execute compile failed: " .. tostring(err))
    end
else
    warn("[AutoCandyFarm] re-execute download failed")
end
]], url, intentCode)

    local ok = pcall(queue, loader)
    dbg("queued re-execution", ok and "ok" or "failed")
    return ok
end

-- ==================== PUBLIC SERVER PICKER ====================
-- Read up to a few pages of the public server list. Roblox returns ping, fps,
-- playing and maxPlayers for every live server. The best candidate is the
-- lowest-ping server that is at least half of maxPlayers. excludeFullGames is
-- important: without it the first pages are all 12/12 servers and the picker
-- never sees a joinable candidate.
local function fetchServerList(placeId)
    local pages = math.clamp(tonumber(Config.ServerHopPages) or 2, 1, 5)
    local servers = {}
    local cursor = nil

    for _ = 1, pages do
        local url = string.format(
            "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Desc&excludeFullGames=true&limit=100",
            placeId
        )

        if cursor and cursor ~= "" then
            local okEncode, encoded = pcall(function()
                return HttpService:UrlEncode(cursor)
            end)
            if not okEncode or type(encoded) ~= "string" then break end
            url = url .. "&cursor=" .. encoded
        end

        local ok, body = pcall(function()
            return game:HttpGet(url)
        end)
        if not ok or type(body) ~= "string" or body == "" then
            dbg("server list fetch failed:", tostring(body))
            break
        end

        local okDecode, data = pcall(function()
            return HttpService:JSONDecode(body)
        end)
        if not okDecode or type(data) ~= "table" or type(data.data) ~= "table" then
            dbg("server list decode failed:", tostring(data))
            break
        end

        for _, srv in ipairs(data.data) do
            table.insert(servers, srv)
        end

        cursor = data.nextPageCursor
        if type(cursor) ~= "string" or cursor == "" then break end
        task.wait(0.1)
    end

    if #servers == 0 then return nil end
    return servers
end

local function pickBestServer(placeId, excludeJobId)
    local servers = fetchServerList(placeId)
    if not servers then return nil, nil end

    local minFill = math.clamp(tonumber(Config.ServerHopMinFill) or 0.5, 0, 1)
    local best, fallback = nil, nil

    for _, srv in ipairs(servers) do
        if type(srv) == "table"
            and type(srv.id) == "string"
            and type(srv.playing) == "number"
            and type(srv.maxPlayers) == "number"
            and srv.id ~= excludeJobId
            and srv.playing < srv.maxPlayers then
            local info = {
                id = srv.id,
                playing = srv.playing,
                maxPlayers = srv.maxPlayers,
                fill = srv.playing / math.max(srv.maxPlayers, 1),
                ping = tonumber(srv.ping) or math.huge,
                fps = tonumber(srv.fps) or 0,
            }

            if info.fill >= minFill then
                if not best
                    or info.ping < best.ping
                    or (info.ping == best.ping and info.playing > best.playing)
                    or (info.ping == best.ping and info.playing == best.playing and info.fps > best.fps) then
                    best = info
                end
            elseif Config.ServerHopAllowFallback ~= false then
                if not fallback
                    or info.playing > fallback.playing
                    or (info.playing == fallback.playing and info.ping < fallback.ping) then
                    fallback = info
                end
            end
        end
    end

    local chosen = best or fallback
    return chosen and chosen.id or nil, chosen
end

-- Kick/disconnect path: return to the same server so the current round can be
-- recovered. If that exact server is unavailable, use the best public server.
local function attemptAutoRejoin(reason, intent)
    if not Config.AutoRejoin then return false end
    dbg("auto-rejoin triggered", tostring(reason))

    local rejoinIntent = intent or {
        kick = true,
        farming = Candy.Enabled and roundActive,
    }

    queueReexecute(rejoinIntent)
    wait()

    local ok = pcall(function()
        TeleportService:Teleport(game.PlaceId, LocalPlayer)
    end)
    dbg("rejoin teleport", ok and "sent" or "failed")
    return ok
end

-- Timeout path: no round for AutoRejoinNoRoundTimeout seconds. Hop to a
-- different server, preferring half-full servers with the lowest ping.
local function hopToBestServer(reason)
    if not Config.AutoRejoin or autoRejoinStarted then return end
    autoRejoinStarted = true
    dbg("server hop triggered", tostring(reason))

    -- This is a fresh round/server, so the re-executed copy must not run the
    -- kicked-while-farming revenge.
    queueReexecute({ kick = false, farming = Candy.Enabled })

    task.spawn(function()
        local minFill = math.clamp(tonumber(Config.ServerHopMinFill) or 0.5, 0, 1)
        local currentJobId = game.JobId

        for attempt = 1, 12 do
            if not Candy.Enabled then
                autoRejoinStarted = false
                return
            end

            local jobId, info = pickBestServer(game.PlaceId, game.JobId)
            if jobId then
                dbg(string.format(
                    "hop pick %s (%d/%d, %.0f%%, ping %s)",
                    jobId, info.playing, info.maxPlayers,
                    (info.fill or 0) * 100, tostring(info.ping)
                ))
                if info.fill < minFill then
                    dbg("no half-full server found; using the most populated fallback")
                end

                local ok = pcall(function()
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, jobId, LocalPlayer)
                end)
                if ok then
                    task.wait(3)
                    -- If the client actually moved, this copy is about to be
                    -- destroyed. If it is still on the same job, retry.
                    if game.JobId ~= currentJobId then return end
                end
            else
                dbg("no suitable public server found; retrying")
            end

            task.wait(math.max(tonumber(Config.ServerHopRetryDelay) or 5, 1))
        end

        if not Candy.Enabled then
            autoRejoinStarted = false
            return
        end

        -- Do not stay stuck if the API/server list is unavailable.
        dbg("server hop retries exhausted; falling back to Teleport")
        pcall(function()
            TeleportService:Teleport(game.PlaceId, LocalPlayer)
        end)
        autoRejoinStarted = false
    end)
end

local function setupAutoRejoin()
    if not Config.AutoRejoin or autoRejoinConnection then return end

    local ok, connection = pcall(function()
        return GuiService.ErrorMessageChanged:Connect(function(errorMessage)
            if type(errorMessage) ~= "string" or errorMessage == "" then
                return
            end

            print("Error detected: " .. tostring(errorMessage))
            if LocalPlayer then
                attemptAutoRejoin("GuiService: " .. tostring(errorMessage), {
                    kick = true,
                    farming = Candy.Enabled and roundActive,
                })
            end
        end)
    end)

    if ok and connection then
        autoRejoinConnection = connection
    else
        dbg("GuiService.ErrorMessageChanged unavailable:", tostring(connection))
    end
end

setupAutoRejoin()

-- ==================== NO-ROUND SERVER HOP WATCHDOG ====================
-- If no round starts for the configured timeout, hop to a half-full public
-- server with the lowest ping instead of rejoining the same dead server.
task.spawn(function()
    while Config.AutoRejoin do
        task.wait(1)

        if not Candy.Enabled then
            roundWaitingSince = tick()
        elseif autoRejoinStarted then
            task.wait(1)
        elseif roundActive then
            roundWaitingSince = nil
        else
            if not roundWaitingSince then
                roundWaitingSince = tick()
            end

            local timeout = math.max(
                tonumber(Config.AutoRejoinNoRoundTimeout) or 90,
                1
            )
            if tick() - roundWaitingSince >= timeout then
                dbg("no round started within", timeout, "seconds; hopping servers")
                hopToBestServer("no round started for " .. tostring(timeout) .. " seconds")
            end
        end
    end
end)

-- ==================== INPUT ====================
local lastHome = 0
local inputConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode ~= Enum.KeyCode.Home then return end
    local now = tick()
    if now - lastHome < 0.35 then return end
    lastHome = now
    toggleCandy(not Candy.Enabled)
end)

-- Clear any anchor left behind by the previous version immediately.
task.defer(function()
    local root = getRoot()
    if root then root.Anchored = false end
end)

-- ==================== TEARDOWN ====================
P.teardown = function()
    Candy.Enabled = false
    Candy.ActiveWorker = nil
    Candy.Running = false
    Candy.Busy = false
    Candy.Target = nil
    revengeToken = revengeToken + 1
    clearCandyMemory()
    runSerial = runSerial + 1

    if deathWatchHum then
        pcall(function() deathWatchHum:Disconnect() end)
        deathWatchHum = nil
    end
    if deathWatchCharConn then
        pcall(function() deathWatchCharConn:Disconnect() end)
        deathWatchCharConn = nil
    end
    if autoRejoinConnection then
        pcall(function() autoRejoinConnection:Disconnect() end)
        autoRejoinConnection = nil
    end

    if inputConnection then
        pcall(function() inputConnection:Disconnect() end)
        inputConnection = nil
    end
    for _, conn in ipairs(roundConnections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(roundConnections)

    releaseCharacter()
    disableNoclip()
    disableAnimationLock()
    P.teardown = nil
end

