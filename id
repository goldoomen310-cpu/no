-- ==================== NOCLIP ====================
-- Kept on for the whole time the farm is enabled, including idle/under-map
-- time, so walls can never block a route. Every BasePart of the character is
-- forced non-collidable on both Stepped and Heartbeat, and a per-part property
-- watcher flips it straight back if the game or the physics step re-enables it,
-- so nothing can ever catch the character on a wall mid-move. Original values
-- are restored when the farm is toggled off.
local noclipEnabled       = false
local noclipConnections   = {}
local noclipCharacterConn = nil
local noclipSaved         = {}
local noclipPartConns     = {}

local function noclipPart(part)
    if not part:IsA("BasePart") then return end
    if noclipSaved[part] == nil then
        noclipSaved[part] = part.CanCollide
        noclipPartConns[part] = part:GetPropertyChangedSignal("CanCollide"):Connect(function()
            if noclipEnabled and part.CanCollide then
                part.CanCollide = false
            end
        end)
    end
    if part.CanCollide then
        part.CanCollide = false
    end
end

local noclipTrackedCharacter = nil
local noclipDescendantConn = nil

local function applyNoclip(char)
    if not noclipEnabled then return end
    char = char or LocalPlayer.Character
    if not char then return end

    -- Only scan the hierarchy when attaching to a new character. During normal
    -- frames, enforce collision state on the cached parts instead of repeatedly
    -- calling GetDescendants() (which created avoidable frame-time spikes).
    if noclipTrackedCharacter ~= char then
        if noclipDescendantConn then
            pcall(function() noclipDescendantConn:Disconnect() end)
            noclipDescendantConn = nil
        end
        noclipTrackedCharacter = char
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then noclipPart(part) end
        end
        noclipDescendantConn = char.DescendantAdded:Connect(function(descendant)
            if descendant:IsA("BasePart") then noclipPart(descendant) end
        end)
        return
    end

    for part in pairs(noclipSaved) do
        if part and part.Parent and part:IsA("BasePart") and part.CanCollide then
            part.CanCollide = false
        end
    end
end

local function dropNoclipPartConns()
    if noclipDescendantConn then
        pcall(function() noclipDescendantConn:Disconnect() end)
        noclipDescendantConn = nil
    end
    noclipTrackedCharacter = nil
    for _, conn in pairs(noclipPartConns) do
        if conn then pcall(function() conn:Disconnect() end) end
    end
    table.clear(noclipPartConns)
end

local function enableNoclip()
    if not Config.Noclip then return end
    if not noclipEnabled then
        noclipEnabled = true
        noclipSaved = {}
        dropNoclipPartConns()

        -- One pre-physics pass is enough; per-part property watchers and the
        -- DescendantAdded listener handle most changes without a second full pass.
        table.insert(noclipConnections, RunService.Stepped:Connect(function()
            applyNoclip()
        end))

        if noclipCharacterConn then noclipCharacterConn:Disconnect() end
        noclipCharacterConn = LocalPlayer.CharacterAdded:Connect(function(char)
            dropNoclipPartConns()
            noclipSaved = {}
            applyNoclip(char)
            task.delay(0.2, function() applyNoclip(char) end)
        end)
    end
    applyNoclip()
end

local function disableNoclip()
    noclipEnabled = false
    for _, conn in ipairs(noclipConnections) do
        if conn then pcall(function() conn:Disconnect() end) end
    end
    table.clear(noclipConnections)
    if noclipCharacterConn then
        noclipCharacterConn:Disconnect()
        noclipCharacterConn = nil
    end
    dropNoclipPartConns()
    for part, canCollide in pairs(noclipSaved) do
        if part and part.Parent then
            pcall(function() part.CanCollide = canCollide end)
        end
    end
    noclipSaved = {}
end

-- ==================== FARM ANIMATION LOCK ====================
-- One emote, forced to the highest priority and replayed whenever the game
-- tries to replace or stop it. The emote is a UGC emote, so its real animation
-- id is resolved out of the emote bundle; the raw animation itself plays fine
-- with Animator:LoadAnimation. The default Animate script is disabled so
-- idle/walk tracks cannot blend over it.
local animLockEnabled    = false
local animLockConnection = nil
local animLockTrack      = nil
local animLockAnimator   = nil
local animLockLastSweep  = 0
local animLockLoadedAt   = 0
local animLockRetries    = 0
local animLockResolved   = false
local animLockSavedAnimate = {}

-- UGC emote assets wrap the real Animation instance. game:GetObjects returns
-- the bundle on executor thread context; take the AnimationId out of it.
local function resolveFarmAnimationId()
    local ok, objects = pcall(function()
        return game:GetObjects("rbxassetid://" .. FARM_EMOTE_ID)
    end)
    if not ok or type(objects) ~= "table" then return nil end

    local found
    local function findAnim(obj)
        if found then return true end
        if obj:IsA("Animation") then
            local digits = tostring(obj.AnimationId):match("(%d+)")
            if digits then
                found = digits
                return true
            end
        end
        for _, child in ipairs(obj:GetChildren()) do
            if findAnim(child) then return true end
        end
        return false
    end

    for _, obj in ipairs(objects) do
        findAnim(obj)
        pcall(function() obj:Destroy() end)
    end

    if found then return "rbxassetid://" .. found end
    return nil
end

local function ensureAnimationLock()
    if not animLockEnabled then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if not animator then return end

    -- Keep the character's own Animate script muted, even if the game tries to
    -- switch it back on.
    local animate = char:FindFirstChild("Animate")
    if animate and animate:IsA("LocalScript") then
        if animLockSavedAnimate[animate] == nil then
            animLockSavedAnimate[animate] = animate.Disabled
        end
        if not animate.Disabled then
            animate.Disabled = true
        end
    end

    if animLockAnimator ~= animator then
        if animLockTrack then
            pcall(function() animLockTrack:Stop(0) end)
        end
        for script, wasDisabled in pairs(animLockSavedAnimate) do
            if not script.Parent then
                animLockSavedAnimate[script] = nil
            end
        end

        animLockAnimator = animator
        animLockTrack = nil

        if not animLockResolved then
            animLockResolved = true
            local resolved = resolveFarmAnimationId()
            if resolved then FARM_ANIMATION_ID = resolved end
        end

        local anim = Instance.new("Animation")
        anim.AnimationId = FARM_ANIMATION_ID
        local ok, track = pcall(function()
            return animator:LoadAnimation(anim)
        end)
        if ok and track then
            track.Looped = true
            track.Priority = Enum.AnimationPriority.Action4
            animLockTrack = track
            animLockLoadedAt = tick()
        end
    end

    if animLockTrack then
        pcall(function()
            animLockTrack.Priority = Enum.AnimationPriority.Action4
        end)
        if not animLockTrack.IsPlaying then
            pcall(function() animLockTrack:Play(0.1, 1, 1) end)
        end

        -- If the asset came back empty, reload once or twice before giving up
        -- (e.g. right after a game update re-uploads the emote).
        if animLockTrack.Length == 0 and tick() - animLockLoadedAt > 1.5
            and animLockRetries < 2 then
            animLockRetries = animLockRetries + 1
            pcall(function() animLockTrack:Stop(0) end)
            animLockTrack = nil
            animLockAnimator = nil
        end
    end

    -- Sweep other tracks a few times a second so gameplay animations cannot
    -- take over the emote. Only sweep while our track is actually playing, so a
    -- failed load cannot leave the character with no animation at all.
    if animLockTrack and animLockTrack.IsPlaying then
        local now = tick()
        if now - animLockLastSweep >= 0.2 then
            animLockLastSweep = now
            for _, other in ipairs(animator:GetPlayingAnimationTracks()) do
                if other ~= animLockTrack then
                    pcall(function() other:Stop(0.1) end)
                end
            end
        end
    end
end

local function enableAnimationLock()
    if animLockEnabled then
        ensureAnimationLock()
        return
    end
    animLockEnabled = true
    animLockLastSweep = 0
    animLockRetries = 0

    if not animLockResolved then
        animLockResolved = true
        local resolved = resolveFarmAnimationId()
        if resolved then FARM_ANIMATION_ID = resolved end
    end
    ensureAnimationLock()
    if animLockConnection then animLockConnection:Disconnect() end
    animLockConnection = RunService.Heartbeat:Connect(ensureAnimationLock)
end

local function disableAnimationLock()
    animLockEnabled = false
    if animLockConnection then
        animLockConnection:Disconnect()
        animLockConnection = nil
    end
    if animLockTrack then
        pcall(function() animLockTrack:Stop(0) end)
        animLockTrack = nil
    end
    animLockAnimator = nil
    for script, wasDisabled in pairs(animLockSavedAnimate) do
        if script and script.Parent then
            pcall(function() script.Disabled = wasDisabled end)
        end
    end
    table.clear(animLockSavedAnimate)
end

-- ==================== UNDER-MAP HIDE ====================
-- This is not anchoring. A heartbeat holds the root at a fixed point below the
-- current map, so gravity cannot drop the character into the void. Home can
-- still cancel it instantly and put the character back on the surface.
local hidden          = false
local hideConnection  = nil
local hideCF          = nil
local hideSavedCF     = nil

local function computeHideCF(root)
    local pos = root.Position
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LocalPlayer.Character }
    params.IgnoreWater = true

    local hit = Workspace:Raycast(pos + Vector3.new(0, 30, 0), Vector3.new(0, -2500, 0), params)
    local floorY = hit and hit.Position.Y or pos.Y
    local depth = tonumber(Config.HideDepth) or 120
    local hidePos = Vector3.new(pos.X, floorY - depth, pos.Z)

    local rotation = root.CFrame - root.CFrame.Position
    return CFrame.new(hidePos) * rotation
end

local function holdHidden()
    if not hidden then return end
    local root = getRoot()
    if not root then return end

    -- The game teleports the character when a new map loads. If that happens,
    -- move the hide point under the new map instead of dragging the character
    -- back toward the old one.
    if hideCF and (root.Position - hideCF.Position).Magnitude > 60 then
        hideSavedCF = root.CFrame
        hideCF = computeHideCF(root)
    end

    if hideCF then
        root.CFrame = hideCF
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
end

local function hideCharacter()
    if not Config.HideUnderMap or not Candy.Enabled then return end
    if hidden then return end

    local root = getRoot()
    if not root then return end

    hideSavedCF = root.CFrame
    hideCF = computeHideCF(root)
    hidden = true
    Candy.Hidden = true

    root.CFrame = hideCF
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    if hideConnection then hideConnection:Disconnect() end
    hideConnection = RunService.Heartbeat:Connect(holdHidden)
end

local function unhideCharacter(toCF)
    if hideConnection then
        hideConnection:Disconnect()
        hideConnection = nil
    end

    local root = getRoot()
    if hidden and root then
        local target = toCF or hideSavedCF
        if target then root.CFrame = target end
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    elseif toCF and root then
        root.CFrame = toCF
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end

    hidden = false
    Candy.Hidden = false
    hideCF = nil
    hideSavedCF = nil
end

local function unhideForCandy(target)
    if not target then return end
    if not hidden then return end
    local p = target.obj.Position + Vector3.new(0, 3.5, 0)
    unhideCharacter(CFrame.new(p))
end

