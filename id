-- ==================== LEASE HEARTBEAT ====================
-- Keeps the duplicate-execution guard fresh while this copy is loaded. When
-- this copy stops, the heartbeat stops, so a later execution can take over
-- after the stale timeout.
task.spawn(function()
    while instanceAlive() do
        local lease = genv[LEASE_KEY]
        if type(lease) ~= "table" or lease.id ~= leaseToken then return end
        lease.heartbeat = tick()
        task.wait(0.5)
    end
end)

-- ==================== TEARDOWN ====================
P.teardown = function()
    Candy.Enabled = false
    Candy.ActiveWorker = nil
    Candy.Running = false
    Candy.Busy = false
    Candy.Target = nil
    Death.token = Death.token + 1
    Scan.clearMemory()

    local lease = genv[LEASE_KEY]
    if type(lease) == "table" and lease.id == leaseToken then
        lease.alive = false
        lease.heartbeat = 0
    end

    if Death.hum then
        pcall(function() Death.hum:Disconnect() end)
        Death.hum = nil
    end
    if Death.charConn then
        pcall(function() Death.charConn:Disconnect() end)
        Death.charConn = nil
    end
    if Rejoin.conn then
        pcall(function() Rejoin.conn:Disconnect() end)
        Rejoin.conn = nil
    end
    if P.boxConn then
        pcall(function() P.boxConn:Disconnect() end)
        P.boxConn = nil
    end
    for _, conn in ipairs(Round.conns) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(Round.conns)
    if inputConnection then
        pcall(function() inputConnection:Disconnect() end)
        inputConnection = nil
    end

    Hide.stopWatch()
    releaseCharacter()
    Noclip.disable()
    AnimLock.disable()
    pcall(Stats.save)
    P.teardown = nil
end

