    local list = Players:GetPlayers()
    for _, player in ipairs(list) do
        if player ~= LocalPlayer and Round.roleOf(player) == "Murderer"
            and not Round.isDead(player) then
            return player
        end
    end
    for _, player in ipairs(list) do
        if player ~= LocalPlayer and Killer.hasKnife(player)
            and not Round.isDead(player) then
            return player
        end
