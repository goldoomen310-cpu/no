local function bagTarget()
    local cap = tonumber(Candy.Cap) or CANDY_CAP
    local limit = tonumber(Candy.MaxCandies) or CANDY_CAP
    return math.max(1, math.min(cap, limit))
end

-- The real authority is the candy bag UI, not our own event counter:
--   MainGUI.Game.CoinBags.Container.Candy.CurrencyFrame.Icon.Coins
local candyCounterLabel = nil

local function findCandyCounterLabel()
    if candyCounterLabel and candyCounterLabel.Parent then
        return candyCounterLabel
    end

    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    local main = pg and pg:FindFirstChild("MainGUI")
    local gameGui = main and main:FindFirstChild("Game")
    local bags = gameGui and gameGui:FindFirstChild("CoinBags")
    if not bags then return nil end

    local container = bags:FindFirstChild("Container")
    local candy = container and container:FindFirstChild("Candy")
    local currency = candy and candy:FindFirstChild("CurrencyFrame")
    local icon = currency and currency:FindFirstChild("Icon")
    local label = icon and icon:FindFirstChild("Coins")
    if label and label:IsA("TextLabel") then
        candyCounterLabel = label
        return label
    end

    -- Fallback if the bag hierarchy moves: find a Coins label whose bag frame
    -- is actually named Candy.
    for _, obj in ipairs(bags:GetDescendants()) do
        if obj:IsA("TextLabel") and obj.Name == "Coins" then
            local iconParent = obj.Parent
            local currencyParent = iconParent and iconParent.Parent
            local bagParent = currencyParent and currencyParent.Parent
            if bagParent and bagParent.Name == "Candy" then
                candyCounterLabel = obj
                return obj
            end
        end
    end
    return nil
end

local function readCandyGuiCount()
    local label = findCandyCounterLabel()
    if not label then return nil end
    local raw = tostring(label.Text):gsub(",", "")
    local digits = raw:match("%d+")
    if not digits then return nil end
    return tonumber(digits)
end

local function refreshCollectedFromGui()
    local n = readCandyGuiCount()
    if n then
        Candy.GuiCount = n
        Candy.Collected = n
    end
    return n
end

local function bagFull()
    -- For ~0.8s after a round's reset the UI can still show last round's value.
    if Candy.GuiReadyAt and tick() < Candy.GuiReadyAt then
        return false
    end
    local guiCount = refreshCollectedFromGui()
    if guiCount then
        return guiCount >= bagTarget()
    end
    return Candy.Collected >= bagTarget()
end

