-- ==================== PERSISTENT STATS + DISCORD WEBHOOK ====================
-- The executor environment is recreated on a rejoin or server hop, so these
-- counters live in a workspace file instead of getgenv. They start at the
-- first execution and are only reset through P.api.resetStats().
local Stats = {
    path = "AutoCandyFarm/stats.json",
    firstRun = os.time(),
    activeSeconds = 0,
    candies = 0,
    cratesOpened = 0,
    rejoins = 0,
    hops = 0,
    rewards = {},
    sessionStart = tick(),
}
do
    local function loadSaved()
        if type(isfile) ~= "function" or type(readfile) ~= "function" then
            return nil
        end
        local okExists, exists = pcall(isfile, Stats.path)
        if not okExists or exists ~= true then return nil end
        local okRead, raw = pcall(readfile, Stats.path)
        if not okRead or type(raw) ~= "string" or raw == "" then return nil end
        local okDecode, data = pcall(function()
            return S.HttpService:JSONDecode(raw)
        end)
        if not okDecode or type(data) ~= "table" then return nil end
        return data
    end

    local saved = loadSaved()
    if type(saved) == "table" then
        Stats.firstRun = tonumber(saved.firstRun) or Stats.firstRun
        Stats.activeSeconds = math.max(0, tonumber(saved.activeSeconds) or 0)
        Stats.candies = math.max(0, tonumber(saved.candies) or 0)
        Stats.cratesOpened = math.max(0, tonumber(saved.cratesOpened) or 0)
        Stats.rejoins = math.max(0, tonumber(saved.rejoins) or 0)
        Stats.hops = math.max(0, tonumber(saved.hops) or 0)
        if type(saved.rewards) == "table" then
            for _, record in ipairs(saved.rewards) do
                if type(record) == "table" then
                    Stats.rewards[#Stats.rewards + 1] = {
                        id = tostring(record.id or ""),
                        name = tostring(record.name or record.id or "?"),
                        type = tostring(record.type or "Item"),
                        rarity = tostring(record.rarity or "?"),
                        at = tonumber(record.at) or 0,
                    }
                end
            end
        end
    end
    Stats.sessionStart = tick()

    function Stats.runtime()
        return Stats.activeSeconds + math.max(0, tick() - Stats.sessionStart)
    end

    function Stats.runtimeText()
        local total = math.floor(Stats.runtime())
        local days = math.floor(total / 86400)
        local hours = math.floor((total % 86400) / 3600)
        local minutes = math.floor((total % 3600) / 60)
        local seconds = total % 60
        if days > 0 then
            return string.format("%dd %dh %dm", days, hours, minutes)
        elseif hours > 0 then
            return string.format("%dh %dm %ds", hours, minutes, seconds)
        end
        return string.format("%dm %ds", minutes, seconds)
    end

    function Stats.save()
        if type(writefile) ~= "function" then return false end
        local snapshot = {
            version = 1,
            firstRun = Stats.firstRun,
            activeSeconds = Stats.runtime(),
            candies = Stats.candies,
            cratesOpened = Stats.cratesOpened,
            rejoins = Stats.rejoins,
            hops = Stats.hops,
            rewards = Stats.rewards,
            savedAt = os.time(),
        }
        local okEncode, encoded = pcall(function()
            return S.HttpService:JSONEncode(snapshot)
        end)
        if not okEncode or type(encoded) ~= "string" then return false end
        local okWrite = pcall(writefile, Stats.path, encoded)
        return okWrite == true
    end

    function Stats.addCandy(amount)
        Stats.candies = math.max(0, Stats.candies + (tonumber(amount) or 1))
    end

    function Stats.addCrate(record)
        Stats.cratesOpened = Stats.cratesOpened + 1
        if type(record) ~= "table" then return end
        Stats.rewards[#Stats.rewards + 1] = {
            id = tostring(record.id or ""),
            name = tostring(record.name or record.id or "?"),
            type = tostring(record.type or "Item"),
            rarity = tostring(record.rarity or "?"),
            color = tonumber(record.color) or Stats.colorForRarity(record.rarity),
            at = tonumber(record.at) or os.time(),
        }
        while #Stats.rewards > 30 do
            table.remove(Stats.rewards, 1)
        end
    end

    function Stats.addRejoin()
        Stats.rejoins = Stats.rejoins + 1
    end

    function Stats.addHop()
        Stats.hops = Stats.hops + 1
    end

    -- Colours mirror Database.Sync.Rarity so the Discord embed matches the
    -- in-game rarity colour (Godly/Chroma are the pink #FF00FF).
    local RARITY_COLORS = {
        Common = 0xFFFFFF,
        Uncommon = 0x00FFFF,
        Rare = 0x00FF00,
        Legendary = 0xFF0000,
        Godly = 0xFF00FF,
        Chroma = 0xFF00FF,
        Ancient = 0x640AFF,
        Unique = 0xFF8C00,
        Christmas = 0x1ED6CD,
        Classic = 0xFFFF00,
        Halloween = 0xDD5602,
        Victim = 0xFF8C00,
    }
    function Stats.colorForRarity(rarity)
        return RARITY_COLORS[tostring(rarity or "")] or 0x5865F2
    end

    function Stats.recentText(limit)
        local lines = {}
        local first = math.max(1, #Stats.rewards - (limit or 4) + 1)
        for i = first, #Stats.rewards do
            local record = Stats.rewards[i]
            lines[#lines + 1] = string.format(
                "%s - %s (%s)", record.name, record.type, record.rarity
            )
        end
        return #lines > 0 and table.concat(lines, "\n") or "None"
    end

    function Stats.webhook(record)
        local url = tostring(Config.WebhookUrl or "")
        if url == "" or type(record) ~= "table" then return end

        local payload = {
            username = tostring(Config.WebhookName or "AutoCandyFarm"),
            embeds = {{
                title = "Opened " .. tostring(Config.AutoBuyBoxName or "crate"),
                color = tonumber(record.color) or Stats.colorForRarity(record.rarity),
                fields = {
                    {
                        name = "Current drop",
                        value = string.format(
                            "%s - %s (%s)", record.name, record.type, record.rarity
                        ),
                        inline = false,
                    },
                    { name = "Item ID", value = tostring(record.id or "?"), inline = true },
                    { name = "Candies collected", value = tostring(Stats.candies), inline = true },
                    { name = "Crates opened", value = tostring(Stats.cratesOpened), inline = true },
                    { name = "Runtime", value = Stats.runtimeText(), inline = true },
                    { name = "Rejoins", value = tostring(Stats.rejoins), inline = true },
                    { name = "Server hops", value = tostring(Stats.hops), inline = true },
                    { name = "Recent drops", value = Stats.recentText(5), inline = false },
                },
                footer = {
                    text = "First run " .. os.date("%Y-%m-%d %H:%M:%S", Stats.firstRun),
                },
                timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
            }},
        }

        local okEncode, body = pcall(function()
            return S.HttpService:JSONEncode(payload)
        end)
        if not okEncode or type(body) ~= "string" then return end

        local httpFn = request or http_request
            or (syn and syn.request) or (http and http.request)
        if type(httpFn) ~= "function" then
            dbg("webhook: no HTTP function available")
            return
        end

        local okRequest, result = pcall(httpFn, {
            Url = url,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = body,
        })
        if not okRequest then
            dbg("webhook error:", tostring(result))
            return
        end
        if type(result) == "table" and result.Success == false then
            dbg("webhook rejected:", tostring(result.StatusCode), tostring(result.Body))
        end
    end

    function Stats.reset()
        Stats.firstRun = os.time()
        Stats.activeSeconds = 0
        Stats.candies = 0
        Stats.cratesOpened = 0
        Stats.rejoins = 0
        Stats.hops = 0
        Stats.rewards = {}
        Stats.sessionStart = tick()
        Stats.save()
    end

    Stats.save()
end
P.stats = Stats

