-- ==================== NO-ROUND SERVER HOP WATCHDOG ====================
-- Bound to the instance token; a previous copy can never keep hopping after a
-- re-execution (that produced two clients fighting over teleports).
task.spawn(function()
    while instanceAlive() and Config.AutoRejoin do
        task.wait(1)
        if not instanceAlive() then return end

        if not Candy.Enabled then
            Round.waitingSince = tick()
        elseif Rejoin.started then
            task.wait(1)
        elseif Round.active then
            Round.waitingSince = nil
        else
            if not Round.waitingSince then Round.waitingSince = tick() end
            local timeout = math.max(tonumber(Config.AutoRejoinNoRoundTimeout) or 90, 1)
            if tick() - Round.waitingSince >= timeout then
                dbg("no round started within", timeout, "seconds; hopping servers")
                Rejoin.hop("no round started for " .. tostring(timeout) .. " seconds")
            end
        end
    end
end)

