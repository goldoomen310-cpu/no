local function getRoot()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart"), char
end

local function getHumanoid()
    local char = LocalPlayer.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function isAlive()
    local hum = getHumanoid()
    return hum ~= nil and hum.Health > 0 and getRoot() ~= nil
end

local function workerOK(id)
    if not instanceAlive() or not Candy.Enabled then return false end
    if id and Candy.ActiveWorker ~= id then return false end
    return true
end

local function bagTarget()
    return math.max(1, tonumber(Candy.Cap) or Config.CandyCap)
end

local function playerFromCharacter(char)
    if not char then return nil end
    return Players:GetPlayerFromCharacter(char)
end

local function planarDistance(a, b)
    local dx, dz = a.X - b.X, a.Z - b.Z
    return math.sqrt(dx * dx + dz * dz)
end

-- ==================== CANDY BAG GUI ====================
-- MainGUI.Game.CoinBags.Container.Candy.CurrencyFrame.Icon.Coins is the only
-- authority for a full bag.
local Bag = { label = nil }
function Bag.findLabel()
    if Bag.label and Bag.label.Parent then return Bag.label end
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    local main = pg and pg:FindFirstChild("MainGUI")
    local gameGui = main and main:FindFirstChild("Game")
    local bags = gameGui and gameGui:FindFirstChild("CoinBags")
    if not bags then return nil end

    local container = bags:FindFirstChild("Container")
    local candy = container and container:FindFirstChild("Candy")
    local currency = candy and candy:FindFirstChild("CurrencyFrame")
    local icon = currency and currency:FindFirstChild("Icon")
    local label = icon and icon:FindFirstChild("Coins")
    if label and label:IsA("TextLabel") then
        Bag.label = label
        return label
    end

    for _, obj in ipairs(bags:GetDescendants()) do
        if obj:IsA("TextLabel") and obj.Name == "Coins" then
            local iconParent = obj.Parent
            local currencyParent = iconParent and iconParent.Parent
            local bagParent = currencyParent and currencyParent.Parent
            if bagParent and bagParent.Name == "Candy" then
                Bag.label = obj
                return obj
            end
        end
    end
    return nil
end

function Bag.count()
    local label = Bag.findLabel()
    if not label then return nil end
    local digits = tostring(label.Text):gsub(",", ""):match("%d+")
    return digits and tonumber(digits) or nil
end

function Bag.refresh()
    local n = Bag.count()
    if n then Candy.Collected = n end
    return n
end

function Bag.full()
    if Candy.GuiReadyAt and tick() < Candy.GuiReadyAt then return false end
    local guiCount = Bag.refresh()
    if guiCount then return guiCount >= bagTarget() end
    return Candy.Collected >= bagTarget()
end

-- ==================== UNDER-MAP HIDE (VOID-SAFE) ====================
local Hide = {
    active         = false,
    conn           = nil,
    watchConn      = nil,
    cf             = nil,
    savedCF        = nil,
    safeCF         = nil,
    floorY         = nil,
    health         = nil,
    blockedUntil   = 0,
    hideDeaths     = 0,
    voidRecoveries = 0,
    surfaceY       = nil,
    lastSafeCF     = nil,
    lastProbe      = 0,
    lastY          = nil,
    MIN_CLEAR      = Config.HideMinFloorClearance,
}

function Hide.params()
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LocalPlayer.Character }
    params.IgnoreWater = true
    return params
end

function Hide.floorAt(x, z, fromY, dist)
    local params = Hide.params()
    local hit = Workspace:Raycast(
        Vector3.new(x, fromY, z),
        Vector3.new(0, -(dist or 5000), 0),
        params
    )
    return hit and hit.Position.Y or nil
end

-- Highest floor within ~16 studs of the column. The character must be at (or
-- near) the surface: if it is already well below the last known surface this
-- returns nil so hiding can never chase the character further down.
function Hide.findFloor(root)
    if not root then return nil end
    local pos = root.Position
    if Hide.surfaceY and pos.Y < Hide.surfaceY - 60 then return nil end

    local fromY = pos.Y + 30
    local offsets = {
        { 0, 0 }, { 8, 0 }, { -8, 0 }, { 0, 8 }, { 0, -8 },
        { 16, 16 }, { -16, 16 }, { 16, -16 }, { -16, -16 },
    }
    local best
    for _, off in ipairs(offsets) do
        local y = Hide.floorAt(pos.X + off[1], pos.Z + off[2], fromY, 800)
        if y and (not best or y > best) then best = y end
    end
    if not best then return nil end
    -- Refuse floors absurdly far below the character (map edge / void).
    if pos.Y - best > 200 then return nil end
    return best
end

function Hide.hideYForFloor(floorY)
    local depth = math.clamp(tonumber(Config.HideDepth) or 120, Config.HideMinDepth, Config.HideMaxDepth)
    local destroyY = tonumber(Workspace.FallenPartsDestroyHeight) or -500
    local minY = destroyY + Hide.MIN_CLEAR + 10
    local hideY = floorY - depth
    if hideY < minY then
        hideY = math.max(minY, floorY - Config.HideMinDepth)
    end
    if hideY >= floorY - 5 then return nil end
    return hideY
end

function Hide.hideCFFor(root)
    local floorY = Hide.findFloor(root)
    if not floorY then return nil end
    local destroyY = tonumber(Workspace.FallenPartsDestroyHeight) or -500
    if floorY <= destroyY + Hide.MIN_CLEAR then return nil end
    local hideY = Hide.hideYForFloor(floorY)
    if not hideY then return nil end
    local rotation = root.CFrame - root.CFrame.Position
    local cf = CFrame.new(root.Position.X, hideY, root.Position.Z) * rotation
    local safe = CFrame.new(root.Position.X, floorY + 5, root.Position.Z)
    return cf, floorY, safe
end

-- A stored surface CFrame is only trustworthy if there is still solid ground
-- directly under it. This rejects old-map coordinates after a map swap.
function Hide.cfSafe(cf)
    if not cf then return false end
    local destroyY = tonumber(Workspace.FallenPartsDestroyHeight) or -500
    if cf.Position.Y <= destroyY + Hide.MIN_CLEAR then return false end
    local y = Hide.floorAt(cf.Position.X, cf.Position.Z, cf.Position.Y + 15, 400)
    if not y then return false end
    if cf.Position.Y - y > 15 then return false end
    return true
end

function Hide.spawnCF()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("SpawnLocation") and obj.Enabled ~= false then
            return CFrame.new(obj.Position + Vector3.new(0, 5, 0))
        end
    end
    return nil
end

function Hide.bestSafeCF()
    if Hide.cfSafe(Hide.lastSafeCF) then return Hide.lastSafeCF + Vector3.new(0, 2, 0) end
    if Hide.cfSafe(Hide.safeCF) then return Hide.safeCF end
    if Hide.cfSafe(Hide.savedCF) then return Hide.savedCF end
    local spawn = Hide.spawnCF()
    if spawn then return spawn end
    local root = getRoot()
    if root then
        local y = Hide.floorAt(root.Position.X, root.Position.Z, 1500, 3000)
        if y then return CFrame.new(root.Position.X, y + 5, root.Position.Z) end
    end
    return CFrame.new(0, 200, 0)
end

function Hide.clear()
    local wasActive = Hide.active
    if Hide.conn then
        pcall(function() Hide.conn:Disconnect() end)
        Hide.conn = nil
    end
    Hide.active = false
    Candy.Hidden = false
    Hide.cf = nil
    Hide.savedCF = nil
    Hide.safeCF = nil
    Hide.floorY = nil
    Hide.health = nil
    if wasActive then
        local root = getRoot()
        if root then pcall(function() root.Anchored = false end) end
    end
end

function Hide.unhide(toCF)
    local wasHidden = Hide.active
    local savedCF = Hide.savedCF
    local safeCF = Hide.safeCF
    Hide.clear()

    -- A plain unhide is a no-op unless we were actually hiding; otherwise
    -- every combat/enable call would teleport the character for no reason.
    if not wasHidden and not toCF then return end

    local root = getRoot()
    if not root or not isAlive() then return end

    local target = toCF
    if not target then
        if Hide.cfSafe(savedCF) then
            target = savedCF
        elseif Hide.cfSafe(safeCF) then
            target = safeCF
        else
            target = Hide.bestSafeCF()
        end
    end
    if not target then return end

    root.Anchored = false
    root.CFrame = target
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
end

function Hide.recover(reason)
    dbg("void recovery:", tostring(reason))
    local root = getRoot()
    Hide.clear()

    Hide.voidRecoveries = Hide.voidRecoveries + 1
    if Hide.voidRecoveries >= 2 then
        Hide.blockedUntil = math.max(Hide.blockedUntil, tick() + 180)
        dbg("hiding paused after repeated void recoveries")
    end

    if Fling.enabled and type(Fling.stop) == "function" then
        pcall(Fling.stop)
    end
    Motion.cancelTween()

    if root and isAlive() then
        local target = Hide.bestSafeCF()
        if target then
            root.Anchored = false
            root.CFrame = target
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
    end
    Hide.blockedUntil = math.max(Hide.blockedUntil, tick() + 3)
end

function Hide.hide()
    if not Config.HideUnderMap then return false end
    if not instanceAlive() or not Candy.Enabled then return false end
    if Hide.active then return true end
    if tick() < Hide.blockedUntil then return false end
    if not isAlive() then return false end
    if Motion.busy() or Motion.tween then return false end

    local root = getRoot()
    if not root then return false end

    -- Never hide if the body is already below the known surface; recover
    -- upward instead of dragging it deeper into the void.
    if Hide.surfaceY and root.Position.Y < Hide.surfaceY - 80 then
        Hide.recover("hide requested below the surface")
        return false
    end

    local cf, floorY, safeCF = Hide.hideCFFor(root)
    if not cf then
        dbg("hide skipped: no valid floor")
        return false
    end

    Hide.savedCF = root.CFrame
    Hide.cf = cf
    Hide.floorY = floorY
    Hide.safeCF = safeCF
    Hide.active = true
    Candy.Hidden = true
    local hum = getHumanoid()
    Hide.health = hum and hum.Health or nil

    -- Anchoring removes the gravity-vs-heartbeat race entirely, so a throttled
    -- client can never fall from the hide point into the destroy plane.
    root.Anchored = true
    root.CFrame = cf
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    if Hide.conn then Hide.conn:Disconnect() end
    Hide.conn = RunService.Heartbeat:Connect(Hide.hold)
    return true
end

function Hide.hold()
    if not Hide.active or not instanceAlive() then return end
    if not isAlive() then
        Hide.clear()
        return
    end
    -- Another system owns the root now; hand it over instead of fighting.
    if Motion.shooting or Motion.teleporting or Motion.tween or Fling.enabled then
        Hide.clear()
        return
    end

    local root = getRoot()
    if not root then return end

    local hum = getHumanoid()
    if hum then
        if Hide.health and hum.Health < Hide.health - 0.01 then
            Hide.recover("damage while hidden")
            return
        end
        Hide.health = hum.Health
    end

    local destroyY = tonumber(Workspace.FallenPartsDestroyHeight) or -500
    if root.Position.Y <= destroyY + Hide.MIN_CLEAR then
        Hide.recover("below destroy height")
        return
    end
    if Hide.cf and root.Position.Y < Hide.cf.Position.Y - 40 then
        Hide.recover("fell below hide point")
        return
    end

    if Hide.cf and (root.Position - Hide.cf.Position).Magnitude > 60 then
        if Hide.floorY and root.Position.Y < Hide.floorY - 10 then
            Hide.recover("moved below the floor")
            return
        end
        local cf, floorY, safeCF = Hide.hideCFFor(root)
        if not cf then
            Hide.recover("new map has no floor")
            return
        end
        Hide.savedCF = root.CFrame
        Hide.cf = cf
        Hide.floorY = floorY
        Hide.safeCF = safeCF
    end

    if Hide.cf then
        root.Anchored = true
        root.CFrame = Hide.cf
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
end

function Hide.unhideForCandy(target)
    if not target or not Hide.active then return end
    Hide.unhide(CFrame.new(target.obj.Position + Vector3.new(0, 3.5, 0)))
end

function Hide.resetRound()
    Hide.hideDeaths = 0
    Hide.voidRecoveries = 0
    Hide.blockedUntil = 0
    Hide.surfaceY = nil
    Hide.lastSafeCF = nil
    Hide.clear()
end

-- Always-on watchdog: rescues the body if it ever drops toward the destroy
-- plane, and records the last verified surface CFrame used by recovery.
function Hide.startWatch()
    if Hide.watchConn then return end
    Hide.watchConn = RunService.Heartbeat:Connect(function()
        if not instanceAlive() or not Candy.Enabled then return end
        local root = getRoot()
        if not root or not isAlive() then return end

        local pos = root.Position
        Hide.lastY = pos.Y
        local destroyY = tonumber(Workspace.FallenPartsDestroyHeight) or -500

        if pos.Y <= destroyY + 60 then
            Hide.recover("watchdog: below destroy plane")
            return
        end

        if not Hide.active and not Motion.busy() then
            local now = tick()
            if now - Hide.lastProbe >= 0.35 then
                Hide.lastProbe = now
                local floor = Hide.floorAt(pos.X, pos.Z, pos.Y + 20, 200)
                local hum = getHumanoid()
                local grounded = hum and hum.FloorMaterial ~= Enum.Material.Air
                if floor and (grounded or (pos.Y - floor) < 6) and pos.Y > destroyY + 120 then
                    Hide.lastSafeCF = CFrame.new(pos)
                    Hide.surfaceY = floor
                    Hide.voidRecoveries = 0
                end
            end
        end

        if not Hide.active and not Motion.busy() and not Motion.tween
            and Hide.surfaceY and pos.Y < Hide.surfaceY - 220 then
            Hide.recover("watchdog: far below the surface")
        end
    end)
end

function Hide.stopWatch()
    if Hide.watchConn then
        pcall(function() Hide.watchConn:Disconnect() end)
        Hide.watchConn = nil
    end
    Hide.clear()
end

-- ==================== NOCLIP ====================
local Noclip = {
    enabled = false, conns = {}, charConn = nil,
    saved = {}, partConns = {}, tracked = nil, descConn = nil,
}
function Noclip.part(part)
    if not part:IsA("BasePart") then return end
    if Noclip.saved[part] == nil then
        Noclip.saved[part] = part.CanCollide
        Noclip.partConns[part] = part:GetPropertyChangedSignal("CanCollide"):Connect(function()
            if Noclip.enabled and part.CanCollide then
                part.CanCollide = false
            end
        end)
    end
    if part.CanCollide then part.CanCollide = false end
end
function Noclip.apply(char)
    if not Noclip.enabled then return end
    char = char or LocalPlayer.Character
    if not char then return end
    if Noclip.tracked ~= char then
        if Noclip.descConn then
            pcall(function() Noclip.descConn:Disconnect() end)
            Noclip.descConn = nil
        end
        Noclip.tracked = char
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then Noclip.part(part) end
        end
        Noclip.descConn = char.DescendantAdded:Connect(function(descendant)
            if descendant:IsA("BasePart") then Noclip.part(descendant) end
        end)
        return
    end
    for part in pairs(Noclip.saved) do
        if part and part.Parent and part:IsA("BasePart") and part.CanCollide then
            part.CanCollide = false
        end
    end
end
function Noclip.dropPartConns()
    if Noclip.descConn then
        pcall(function() Noclip.descConn:Disconnect() end)
        Noclip.descConn = nil
    end
    Noclip.tracked = nil
    for _, conn in pairs(Noclip.partConns) do
        if conn then pcall(function() conn:Disconnect() end) end
    end
    table.clear(Noclip.partConns)
end
function Noclip.enable()
    if not Config.Noclip then return end
    if not Noclip.enabled then
        Noclip.enabled = true
        Noclip.saved = {}
        Noclip.dropPartConns()
        table.insert(Noclip.conns, RunService.Stepped:Connect(function()
            Noclip.apply()
        end))
        if Noclip.charConn then Noclip.charConn:Disconnect() end
        Noclip.charConn = onCharacterAdded(function(char)
            if not instanceAlive() then return end
            Noclip.dropPartConns()
            Noclip.saved = {}
            Noclip.apply(char)
            task.delay(0.2, function()
                if instanceAlive() and LocalPlayer.Character == char then
                    Noclip.apply(char)
                end
            end)
        end)
    end
    Noclip.apply()
end
function Noclip.disable()
    Noclip.enabled = false
    for _, conn in ipairs(Noclip.conns) do
        if conn then pcall(function() conn:Disconnect() end) end
    end
    table.clear(Noclip.conns)
    if Noclip.charConn then
        pcall(function() Noclip.charConn:Disconnect() end)
        Noclip.charConn = nil
    end
    Noclip.dropPartConns()
    for part, canCollide in pairs(Noclip.saved) do
        if part and part.Parent then
            pcall(function() part.CanCollide = canCollide end)
        end
    end
    Noclip.saved = {}
end

-- ==================== FARM ANIMATION LOCK ====================
local AnimLock = {
    enabled = false, conn = nil, track = nil, animator = nil,
    lastSweep = 0, loadedAt = 0, retries = 0, resolved = false,
    savedAnimates = {},
    emoteId = "71336154532229",
    animationId = "rbxassetid://130449961562896",
}
do
    local function resolveId()
        local ok, objects = pcall(function()
            return game:GetObjects("rbxassetid://" .. AnimLock.emoteId)
        end)
        if not ok or type(objects) ~= "table" then return nil end
        local found
        local function findAnim(obj)
            if found then return true end
            if obj:IsA("Animation") then
                local digits = tostring(obj.AnimationId):match("(%d+)")
                if digits then
                    found = digits
                    return true
                end
            end
            for _, child in ipairs(obj:GetChildren()) do
                if findAnim(child) then return true end
            end
            return false
        end
        for _, obj in ipairs(objects) do
            findAnim(obj)
            pcall(function() obj:Destroy() end)
        end
        return found and ("rbxassetid://" .. found) or nil
    end

    function AnimLock.ensure()
        if not AnimLock.enabled then return end
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local animator = hum and hum:FindFirstChildOfClass("Animator")
        if not animator then return end

        local animate = char:FindFirstChild("Animate")
        if animate and animate:IsA("LocalScript") then
            if AnimLock.savedAnimates[animate] == nil then
                AnimLock.savedAnimates[animate] = animate.Disabled
            end
            if not animate.Disabled then animate.Disabled = true end
        end

        if AnimLock.animator ~= animator then
            if AnimLock.track then
                pcall(function() AnimLock.track:Stop(0) end)
            end
            for script, wasDisabled in pairs(AnimLock.savedAnimates) do
                if not script.Parent then AnimLock.savedAnimates[script] = nil end
            end
            AnimLock.animator = animator
            AnimLock.track = nil

            if not AnimLock.resolved then
                AnimLock.resolved = true
                local resolved = resolveId()
                if resolved then AnimLock.animationId = resolved end
            end

            local anim = Instance.new("Animation")
            anim.AnimationId = AnimLock.animationId
            local ok, track = pcall(function()
                return animator:LoadAnimation(anim)
            end)
            if ok and track then
                track.Looped = true
                track.Priority = Enum.AnimationPriority.Action4
                AnimLock.track = track
                AnimLock.loadedAt = tick()
            end
        end

        if AnimLock.track then
            pcall(function()
                AnimLock.track.Priority = Enum.AnimationPriority.Action4
            end)
            if not AnimLock.track.IsPlaying then
                pcall(function() AnimLock.track:Play(0.1, 1, 1) end)
            end
            if AnimLock.track.Length == 0 and tick() - AnimLock.loadedAt > 1.5
                and AnimLock.retries < 2 then
                AnimLock.retries = AnimLock.retries + 1
                pcall(function() AnimLock.track:Stop(0) end)
                AnimLock.track = nil
                AnimLock.animator = nil
            end
        end

        if AnimLock.track and AnimLock.track.IsPlaying then
            local now = tick()
            if now - AnimLock.lastSweep >= 0.2 then
                AnimLock.lastSweep = now
                for _, other in ipairs(animator:GetPlayingAnimationTracks()) do
                    if other ~= AnimLock.track then
                        pcall(function() other:Stop(0.1) end)
                    end
                end
            end
        end
    end

    function AnimLock.enable()
        if AnimLock.enabled then
            AnimLock.ensure()
            return
        end
        AnimLock.enabled = true
        AnimLock.lastSweep = 0
        AnimLock.retries = 0
        if not AnimLock.resolved then
            AnimLock.resolved = true
            local resolved = resolveId()
            if resolved then AnimLock.animationId = resolved end
        end
        AnimLock.ensure()
        if AnimLock.conn then AnimLock.conn:Disconnect() end
        AnimLock.conn = RunService.Heartbeat:Connect(AnimLock.ensure)
    end

    function AnimLock.disable()
        AnimLock.enabled = false
        if AnimLock.conn then
            AnimLock.conn:Disconnect()
            AnimLock.conn = nil
        end
        if AnimLock.track then
            pcall(function() AnimLock.track:Stop(0) end)
            AnimLock.track = nil
        end
        AnimLock.animator = nil
        for script, wasDisabled in pairs(AnimLock.savedAnimates) do
            if script and script.Parent then
                pcall(function() script.Disabled = wasDisabled end)
            end
        end
        table.clear(AnimLock.savedAnimates)
    end
end

