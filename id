local InstanceHandleLib = nil
do
    local ok, lib = pcall(function() return InstanceHandle end)
    if ok and typeof(lib) == "table" and type(lib.new) == "function" then
        InstanceHandleLib = lib
    end
end

local function setPhysicsRep(part, targetPart)
    if not part or not targetPart then return false end
    local ok = pcall(function()
        sethiddenproperty(part, "PhysicsRepRootPart", targetPart)
    end)
    if not ok then return false end
    if InstanceHandleLib then
        pcall(function()
            sethiddenproperty(part, "PhysicsRepRootRef", InstanceHandleLib.new(targetPart))
        end)
    end
    return true
end

local function clearPhysicsRep(part)
    if not part then return end
    pcall(function() sethiddenproperty(part, "PhysicsRepRootPart", nil) end)
    pcall(function() sethiddenproperty(part, "PhysicsRepRootRef", nil) end)
end

-- ==================== PLAYER DATA ====================
local function applyPlayerData(data)
    if type(data) == "table" then
        playerData = data
    end
end

local function refreshPlayerData()
    if playerDataBusy then return end
    playerDataBusy = true
    task.spawn(function()
        local ok, data = pcall(function()
            return Gameplay.GetCurrentPlayerData:InvokeServer()
        end)
        if ok and type(data) == "table" then
            playerData = data
        end
        playerDataBusy = false
    end)
end

local function waitForRole(timeout)
    local t0 = tick()
    while tick() - t0 < (timeout or 3) do
        local role = myRole()
        if role then return role end
        task.spawn(refreshPlayerData)
        task.wait(0.35)
    end
    return myRole()
end

-- ==================== ROUND STATE ====================
local function readTimer()
    local part = Workspace:FindFirstChild("RoundTimerPart")
    if not part then return nil, nil end
    return tonumber(part:GetAttribute("Time")), tonumber(part:GetAttribute("RoundLength"))
end

local function markRoundEnd(reason)
    if roundActive then
        dbg("round end", reason or "")
        roundWaitingSince = tick()
    elseif not roundWaitingSince then
        roundWaitingSince = tick()
    end
    roundActive = false
    roundStartTime = 0
    Candy.Busy = false
    Candy.Target = nil
    cancelTween()
    clearCandyMemory()
    unhideCharacter()
end

local function markRoundStart(source, data)
    if type(data) == "table" then
        playerData = data
    end
    roundActive = true
    roundStartTime = tick()
    roundWaitingSince = nil
    roundSerial = roundSerial + 1
    Candy.LastScan = 0
    Candy.Cache = {}
    clearCandyMemory()
    task.spawn(refreshPlayerData)
    dbg("round start", source or "")
end

-- Detect a round that was already running when the script was toggled on.
local function detectActiveRound()
    local timeLeft, roundLength = readTimer()
    if not timeLeft or timeLeft <= 2 then
        return false
    end
    if not isAlive() then
        return false
    end
    if not myRole() then
        task.spawn(refreshPlayerData)
        return false
    end

    local len = roundLength or 180
    local elapsed = math.clamp(len - timeLeft, 0, len)
    roundActive = true
    roundStartTime = tick() - elapsed
    roundWaitingSince = nil
    roundSerial = roundSerial + 1
    Candy.LastScan = 0
    Candy.Cache = {}
    dbg("round already active, elapsed=", math.floor(elapsed))
    return true
end

local roundConnections = {}
local function connectRound(src, name, fn)
    local ev = src:FindFirstChild(name)
    if not ev then return end
    if not (ev:IsA("RemoteEvent") or ev:IsA("RemoteFunction")) then return end
    local ok, conn = pcall(function()
        if ev:IsA("RemoteEvent") then
            return ev.OnClientEvent:Connect(function(...)
                local good, err = pcall(fn, ...)
                if not good then warn("[round] " .. name .. ": " .. tostring(err)) end
            end)
        else
            ev.OnClientInvoke = function(...)
                local good, err = pcall(fn, ...)
                if not good then warn("[round] " .. name .. ": " .. tostring(err)) end
            end
            return nil
        end
    end)
    if ok and conn then
        table.insert(roundConnections, conn)
    end
end

connectRound(Gameplay, "RoundStart", function(duration, data)
    markRoundStart("RoundStart", data)
end)
connectRound(Gameplay, "CoinsStarted", function()
    if not roundActive then
        markRoundStart("CoinsStarted")
    end
    Candy.LastScan = 0
end)
connectRound(Gameplay, "RoleSelect", function(role)
    if type(role) == "string" and role ~= "" then
        playerData[LocalPlayer.Name] = playerData[LocalPlayer.Name] or {}
        playerData[LocalPlayer.Name].Role = role
    end
    task.spawn(refreshPlayerData)
end)
connectRound(Gameplay, "PlayerDataChanged", function(data)
    applyPlayerData(data)
end)
connectRound(Gameplay, "VictoryScreen", function() markRoundEnd("VictoryScreen") end)
connectRound(Gameplay, "GameOver", function() markRoundEnd("GameOver") end)
connectRound(Gameplay, "RoundEndFade", function() markRoundEnd("RoundEndFade") end)
connectRound(Gameplay, "LoadingMap", function()
    markRoundEnd("LoadingMap")
    Candy.Cache = {}
    Candy.LastScan = 0
end)

local coinCollected = Gameplay:FindFirstChild("CoinCollected")
if coinCollected and coinCollected:IsA("RemoteEvent") then
    table.insert(roundConnections, coinCollected.OnClientEvent:Connect(function(coinId, count, cap)
        if coinId ~= nil and coinId ~= CANDY_VALUE then return end
        if type(count) == "number" then
            Candy.ServerCount = count
            local guiCount = refreshCollectedFromGui()
            if not guiCount then
                Candy.Collected = count
            end
        end
        if type(cap) == "number" and cap > 0 then
            Candy.Cap = cap
        end
    end))
end

