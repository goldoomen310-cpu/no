-- ==================== CANDY DETECTION ====================
do
    local VISUAL_NAMES = {
        CoinVisual = true, SpinningVisual = true,
        SpinningVisuals = true, MainCoin = true,
    }
    local ids = setmetatable({}, { __mode = "k" })
    local nextId = 0

    local function key(obj)
        local id = ids[obj]
        if not id then
            nextId = nextId + 1
            id = nextId
            ids[obj] = id
        end
        return id
    end

    local function isCandyPart(obj)
        if not obj or not obj:IsA("BasePart") then return false end
        if VISUAL_NAMES[obj.Name] then return false end
        if obj:GetAttribute("CoinID") == "Candy" then return true end
        local lname = obj.Name:lower()
        return lname:find("candy") ~= nil or lname:find("candie") ~= nil
    end

    local function available(obj)
        if not obj or not obj.Parent then return false end
        if obj:GetAttribute("Collected") == true then return false end
        if obj:GetAttribute("Delete") == true then return false end
        return true
    end

    local function containers()
        local out = {}
        for _, child in ipairs(Workspace:GetChildren()) do
            local cc
            if child.Name == "CoinContainer" then
                cc = child
            else
                cc = child:FindFirstChild("CoinContainer")
            end
            if cc then out[#out + 1] = cc end
        end
        return out
    end

    function Scan.available(obj) return available(obj) end

    function Scan.scan(root)
        local list, cache = {}, {}
        local playerPos = root.Position
        for _, cc in ipairs(containers()) do
            for _, obj in ipairs(cc:GetChildren()) do
                if isCandyPart(obj) and available(obj) then
                    cache[#cache + 1] = obj
                    local d = (obj.Position - playerPos).Magnitude
                    if d <= Candy.MaxDistance then
                        list[#list + 1] = { obj = obj, dist = d }
                    end
                end
            end
        end
        Candy.Cache = cache
        Candy.LastScan = tick()
        return list
    end

    function Scan.list(force)
        local root = getRoot()
        if not root then return {} end
        local now = tick()
        if force or (now - Candy.LastScan) > Config.CandyCacheTTL or #Candy.Cache == 0 then
            return Scan.scan(root)
        end
        local list, playerPos = {}, root.Position
        for _, obj in ipairs(Candy.Cache) do
            if available(obj) then
                local d = (obj.Position - playerPos).Magnitude
                if d <= Candy.MaxDistance then
                    list[#list + 1] = { obj = obj, dist = d }
                end
            end
        end
        if #list == 0 then return Scan.scan(root) end
        return list
    end

    -- Reject candy that sits in the void: at/below the destroy plane, or far
    -- under the surface with no floor underneath it.
    function Scan.safeAt(obj, killerPos)
        if not obj or not obj.Parent then return false end
        local pos = obj.Position
        local destroyY = tonumber(Workspace.FallenPartsDestroyHeight) or -500
        if pos.Y <= destroyY + 60 then return false end
        if Hide.surfaceY and pos.Y < Hide.surfaceY - 200 then
            if not Hide.floorAt(pos.X, pos.Z, pos.Y + 40, 600) then
                return false
            end
        end
        if killerPos then
            local horizontal = planarDistance(pos, killerPos)
            if horizontal <= Config.KillerIgnoreRadius
                and math.abs(pos.Y - killerPos.Y) <= Config.KillerIgnoreHeight then
                return false
            end
        end
        return true
    end

    function Scan.safe(obj)
        return Scan.safeAt(obj, Killer.pos())
    end

    function Scan.best(list)
        local root = getRoot()
        if not root then return nil end
        local origin = (Hide.active and Hide.savedCF) and Hide.savedCF.Position or root.Position
        local now = tick()
        local killerPos = Killer.pos()
        local best, bestDist, bestKey
        local soonestBlocked = math.huge

        for _, c in ipairs(list) do
            local obj = c.obj
            if available(obj) and Scan.safeAt(obj, killerPos) then
                local blockedUntil = Candy.SkipUntil[obj]
                if blockedUntil and blockedUntil > now then
                    if blockedUntil < soonestBlocked then soonestBlocked = blockedUntil end
                else
                    local pos = obj.Position
                    local dist = (pos - origin).Magnitude
                    local k = key(obj)
                    if not best
                        or dist < bestDist
                        or (dist == bestDist and k < bestKey) then
                        best = { obj = obj, pos = pos, dist = dist, key = k }
                        bestDist = dist
                        bestKey = k
                    end
                end
            end
        end

        if not best then
            Candy.Plan = nil
            if soonestBlocked < math.huge then
                return nil, math.max(0.05, soonestBlocked - now)
            end
            return nil
        end

        Candy.Plan = {
            first = best.obj,
            count = 1,
            distance = best.dist,
            route = { best.obj },
        }
        return best
    end

    function Scan.markFailure(obj)
        if not obj then return end
        local rec = Candy.Failures[obj]
        if not rec then
            rec = { count = 0 }
            Candy.Failures[obj] = rec
        end
        rec.count = rec.count + 1
        local cooldown = math.min(30, 0.6 * (2 ^ (rec.count - 1)))
        Candy.SkipUntil[obj] = tick() + cooldown
        dbg("candy failed", obj:GetFullName(), "attempts", rec.count, "cooldown", cooldown)
    end

    function Scan.clearMemory()
        Candy.SkipUntil = {}
        Candy.Failures = {}
        Candy.Plan = nil
    end
end

-- ==================== MOVEMENT / COLLECTION ====================
local function fireTouch(partA, partB)
    if not partA or not partB then return end
    pcall(function()
        firetouchinterest(partA, partB, 0)
        firetouchinterest(partA, partB, 1)
    end)
end

local Move = {}
function Move.to(goalPos, speed, stopFn, touchPart)
    if not instanceAlive() then return false end
    if Motion.busy() then return false end
    if Config.Noclip then
        Noclip.enable()
        Noclip.apply()
    end

    local root = getRoot()
    if not root then return false end
    local charAtStart = LocalPlayer.Character

    speed = math.max(tonumber(speed) or 1, 1)
    local startPos = root.Position
    local initialDistance = (goalPos - startPos).Magnitude
    if initialDistance < 0.05 then return true end

    Motion.cancelTween()
    local hum = getHumanoid()
    local autoRotate = hum and hum.AutoRotate
    if hum then hum.AutoRotate = false end

    root.Anchored = true
    local originalGravity = Workspace.Gravity
    local goalCF = CFrame.new(goalPos) * root.CFrame.Rotation
    local duration = math.max(initialDistance / speed, 0.01)

    Workspace.Gravity = 0
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    local tween
    local okCreate = pcall(function()
        tween = TweenService:Create(
            root,
            TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, 0, false, 0),
            { CFrame = goalCF }
        )
    end)
    if not okCreate or not tween then
        Workspace.Gravity = originalGravity
        if root and root.Parent then root.Anchored = false end
        if hum and hum.Parent and autoRotate ~= nil then hum.AutoRotate = autoRotate end
        dbg("tween create failed")
        return false
    end

    local finished = false
    local completedConn = tween.Completed:Connect(function(state)
        if state == Enum.PlaybackState.Completed then finished = true end
    end)

    Motion.tween = tween
    tween:Play()

    local startedAt = tick()
    local deadline = startedAt + duration + 4
    local lastPos = startPos
    local lastProgressAt = startedAt
    local unanchorAt = math.clamp(tonumber(Config.MoveUnanchorAt) or 0.8, 0.1, 1)
    local earlyTouchDistance = math.max(tonumber(Config.EarlyTouchDistance) or 10, 1)
    local unanchoredEarly = false
    local lastTouchAt = 0
    local voidHit = false

    local loopOk, loopErr = pcall(function()
        while not finished do
            if not root.Parent then break end
            if not instanceAlive() or LocalPlayer.Character ~= charAtStart then break end
            if not Candy.Enabled or not Round.active or not isAlive() then break end
            if Motion.tween ~= tween then break end
            if stopFn and stopFn() then break end
            if tick() > deadline then break end

            if Config.Noclip then Noclip.apply() end

            local now = tick()
            local pos = root.Position
            local destroyY = tonumber(Workspace.FallenPartsDestroyHeight) or -500
            if pos.Y <= destroyY + 60 then
                voidHit = true
                break
            end

            local remaining = (goalPos - pos).Magnitude
            local progress = 1 - remaining / math.max(initialDistance, 0.001)

            if not unanchoredEarly and progress >= unanchorAt then
                unanchoredEarly = true
                if root.Anchored then root.Anchored = false end
            end

            if unanchoredEarly then
                if root.Anchored then root.Anchored = false end
            elseif not root.Anchored then
                root.Anchored = true
            end

            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero

            -- Fire as soon as the candy is within reach, even while the root
            -- is still anchored/approaching. This is what lets a candy five
            -- studs overhead be collected without climbing onto it first.
            if touchPart and touchPart.Parent
                and now - lastTouchAt >= 0.05 then
                local touchDist = (touchPart.Position - pos).Magnitude
                if touchDist <= earlyTouchDistance then
                    lastTouchAt = now
                    fireTouch(root, touchPart)
                end
            end

            if (pos - lastPos).Magnitude > 0.005 then
                lastPos = pos
                lastProgressAt = now
            elseif now - lastProgressAt > 1.5 then
                dbg("move stalled", initialDistance, "studs")
                break
            end

            RunService.Heartbeat:Wait()
        end
    end)
    if not loopOk then dbg("move error:", tostring(loopErr)) end

    if not finished then pcall(function() tween:Cancel() end) end
    completedConn:Disconnect()
    if Motion.tween == tween then Motion.tween = nil end

    Workspace.Gravity = originalGravity

    if root and root.Parent then
        if finished then root.CFrame = goalCF end
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        root.Anchored = false
    end
    if hum and hum.Parent and autoRotate ~= nil then hum.AutoRotate = autoRotate end

    if voidHit then
        Hide.recover("move fell into the void")
        return false
    end
    return finished
end

-- One-shot snap used for the first candy of a round. Teleporting from the
-- spawn point (or from under the map while hidden) saves the opening seconds;
-- the rest of the round keeps using the normal tween path. Returns true only
-- if the root was actually moved, so the caller can mark the round consumed.
function Move.firstTeleport(target)
    if not target or not target.obj or not target.obj.Parent then return false end
    if not instanceAlive() or not Candy.Enabled or not Round.active or not isAlive() then
        return false
    end
    if Motion.busy() or Motion.tween then return false end

    local obj = target.obj
    if not Scan.safe(obj) then return false end
    local root = getRoot()
    if not root then return false end

    Hide.clear()
    Motion.cancelTween()

    local pos = obj.Position + Vector3.new(0, 3, 0)
    root.Anchored = false
    root.CFrame = CFrame.new(pos) * root.CFrame.Rotation
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    if Config.Noclip then
        Noclip.enable()
        Noclip.apply()
    end
    fireTouch(root, obj)
    dbg("first candy teleport", obj:GetFullName())
    return true
end

function Move.collect(target, id)
    if not target or not Scan.available(target.obj) then return false, "gone" end
    if Motion.busy() then return false, "busy" end
    local root = getRoot()
    if not root then return false, "dead" end

    local obj = target.obj
    Candy.Busy = true
    Candy.Target = target

    -- firetouchinterest does not need physical contact. Poke the candy once
    -- while it is still within reach (e.g. the root is five studs below it)
    -- so the server can award it before the approach tween even finishes.
    local reach = math.max(tonumber(Config.EarlyTouchDistance) or 10, 1)
    if (obj.Position - root.Position).Magnitude <= reach then
        fireTouch(root, obj)
    end

    local function stopFn()
        if not instanceAlive() or not Candy.Enabled or not Round.active or not isAlive() then
            return true
        end
        if id and Candy.ActiveWorker ~= id then return true end
        if WaitTurn.poll() then return true end
        if not Scan.available(obj) then return true end
        if not Scan.safe(obj) then return true end
        return false
    end

    local reached = Move.to(obj.Position, Candy.TweenSpeed, stopFn, obj)

    if reached and Candy.Enabled and Round.active and isAlive() and Scan.available(obj) then
        local r = getRoot()
        if r and obj and obj.Parent then
            local previousGravity = Workspace.Gravity
            local touchOk = false
            local ok, err = pcall(function()
                Workspace.Gravity = 0
                r.AssemblyLinearVelocity = Vector3.zero
                r.AssemblyAngularVelocity = Vector3.zero

                local finishTime = math.clamp(tonumber(Config.PickupFinishTime) or 0.12, 0.02, 0.5)
                local touchUntil = tick() + finishTime
                repeat
                    if not Candy.Enabled or not Round.active or not isAlive() then break end
                    if not obj.Parent or not Scan.available(obj) then break end
                    r.CFrame = CFrame.new(obj.Position) * r.CFrame.Rotation
                    r.AssemblyLinearVelocity = Vector3.zero
                    r.AssemblyAngularVelocity = Vector3.zero
                    fireTouch(r, obj)
                    RunService.Heartbeat:Wait()
                until tick() >= touchUntil
                touchOk = not Scan.available(obj)
            end)

            if r and r.Parent then
                r.AssemblyLinearVelocity = Vector3.zero
                r.AssemblyAngularVelocity = Vector3.zero
            end
            Workspace.Gravity = previousGravity
            if not ok then dbg("pickup touch error:", tostring(err)) end
            if not touchOk and Scan.available(obj) then
                fireTouch(r, obj)
                task.wait(0.05)
            end
        end
    end

    local got = not Scan.available(obj)
    Candy.Busy = false
    Candy.Target = nil

    if got then
        Candy.Picked = Candy.Picked + 1
        Stats.addCandy(1)
        Candy.SkipUntil[obj] = nil
        Candy.Failures[obj] = nil
        local guiCount = Bag.refresh()
        if not guiCount then
            Candy.Collected = math.max(Candy.Picked, Candy.ServerCount)
        end
        dbg("collected", Candy.Collected, "/", bagTarget(), "gui=", tostring(guiCount))
        return true, "collected"
    end

    if not Candy.Enabled then return false, "disabled" end
    if not Round.active then return false, "roundEnded" end
    if not isAlive() then return false, "dead" end
    if not obj.Parent then return false, "gone" end
    if not Scan.available(obj) then return true, "collected" end
    if WaitTurn.poll() then return false, "waiting" end
    if not Scan.safe(obj) then return false, "danger" end
    return false, "unreachable"
end

-- ==================== GUN ====================
local Gun = {}
function Gun.findTool()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack and char then backpack = char:FindFirstChildOfClass("Backpack") end
    local function scan(container)
        if not container then return nil end
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("Tool") and child.Name:lower():find("gun") then
                return child
            end
        end
        return nil
    end
    return scan(char) or scan(backpack)
end
function Gun.has()
    return Gun.findTool() ~= nil
end
function Gun.hasOn(player)
    local char = player.Character
    if char and char:FindFirstChild("Gun") then return true end
    local containers = {}
    if char then table.insert(containers, char) end
    local backpack = player:FindFirstChild("Backpack")
    if not backpack and char then backpack = char:FindFirstChildOfClass("Backpack") end
    if backpack then table.insert(containers, backpack) end
    for _, container in ipairs(containers) do
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("Tool") and child.Name:lower():find("gun") then
                return true
            end
        end
    end
    return false
end
function Gun.holder()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and not Round.isDead(player) and Gun.hasOn(player) then
            return player
        end
    end
    return nil
end
function Gun.sheriff()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and Round.roleOf(player) == "Sheriff"
            and not Round.isDead(player) then
            return player
        end
    end
    return nil
end
function Gun.equip()
    local char = LocalPlayer.Character
    if not char then return nil end
    local gun = Gun.findTool()
    if not gun then return nil end
    if gun.Parent == char then return gun end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end
    pcall(function() hum:EquipTool(gun) end)
    local t0 = tick()
    repeat
        task.wait(0.05)
        gun = Gun.findTool()
    until (gun and gun.Parent == char) or tick() - t0 > 1.5
    if gun and gun.Parent == char then return gun end
    return nil
end
function Gun.shootRemote(gun)
    if not gun then return nil end
    local shoot = gun:FindFirstChild("Shoot")
    if shoot and shoot:IsA("RemoteEvent") then return shoot end
    for _, child in ipairs(gun:GetDescendants()) do
        if child:IsA("RemoteEvent") and child.Name:lower() == "shoot" then
            return child
        end
    end
    return nil
end
function Gun.aim(killer)
    local char = killer and killer.Character
    if not char then return nil end
    local part = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    return part and part.Position or nil
end
function Gun.down(killer)
    if not killer or not killer.Parent then return true end
    local char = killer.Character
    if not char then return true end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum == nil or hum.Health <= 0
end
function Gun.fire(killer, gun, immediate)
    gun = gun or Gun.equip()
    if not gun then return false end
    local remote = Gun.shootRemote(gun)
    if not remote then
        warn("[shoot] gun has no Shoot remote")
        return false
    end
    local root = getRoot()
    if not root then return false end
    local aim = Gun.aim(killer)
    if not aim then return false end

    local attachment = root:FindFirstChild("GunRaycastAttachment")
    if not attachment and not immediate then
        local t0 = tick()
        repeat
            task.wait(0.03)
            attachment = root:FindFirstChild("GunRaycastAttachment")
        until attachment or tick() - t0 > 0.6
    end
    local origin = attachment and attachment.WorldCFrame
        or CFrame.new(root.Position + Vector3.new(0, 1, 0))

    local ok, err = pcall(function()
        remote:FireServer(origin, CFrame.new(aim))
    end)
    if not ok then
        warn("[shoot] FireServer failed: " .. tostring(err))
        return false
    end
    return true
end
function Gun.behindCF(killer)
    local char = killer and killer.Character
    local killerRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not killerRoot then return nil end
    local look = killerRoot.CFrame.LookVector
    local flat = Vector3.new(look.X, 0, look.Z)
    if flat.Magnitude < 0.001 then
        flat = Vector3.new(0, 0, 1)
    else
        flat = flat.Unit
    end
    local distance = tonumber(Config.SyncBehindDistance) or 3
    local height = tonumber(Config.SyncBehindHeight) or 1
    local behind = killerRoot.Position - flat * distance + Vector3.new(0, height, 0)
    return CFrame.new(behind, killerRoot.Position)
end

local function syncBehind(killer, root, physicsTarget)
    local cf = Gun.behindCF(killer)
    if not cf then return false end
    if root.Anchored then root.Anchored = false end
    root.CFrame = cf
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    if physicsTarget then Phys.set(root, physicsTarget) end
    return true
end

-- Synced volley behind the murderer. Guarded so a second combat caller, a
-- fling, or a gun teleport can never fight it for the root.
function Gun.shoot(silent)
    if Motion.shooting or Motion.teleporting or Fling.enabled or Revenge.active then
        return false, false
    end
    if tick() - Motion.lastShot < Config.TeleportShootCooldown then return false, false end
    if not instanceAlive() or not isAlive() then return false, false end
    if not Gun.has() then
        if not silent then print("[candy] no gun") end
        return false, false
    end

    local killer = Killer.find()
    if not killer or not killer.Character then
        if not silent then print("[candy] no murderer") end
        return false, false
    end

    local root = getRoot()
    local killerRoot = killer.Character:FindFirstChild("HumanoidRootPart")
    if not root or not killerRoot then return false, false end

    Motion.shooting = true
    Motion.lastShot = tick()
    Motion.cancelTween()
    if Hide.active then Hide.unhide() end

    local gun = Gun.equip()
    if not gun then
        Motion.shooting = false
        return false, false
    end

    local hum = getHumanoid()
    local autoRotate = hum and hum.AutoRotate
    if hum then hum.AutoRotate = false end

    local originalCF = root.CFrame
    local saved = {}
    local char = LocalPlayer.Character
    if not char then
        Motion.shooting = false
        return false, false
    end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            saved[part] = part.CanCollide
            part.CanCollide = false
        end
    end

    local firedAny = false
    local hit = false
    local ok, err = pcall(function()
        local killerHead = killer.Character and killer.Character:FindFirstChild("Head")
        if not killerHead then killerHead = killerRoot end

        local holdTime = math.clamp(tonumber(Config.SyncHoldTime) or 1.0, 0.2, 5)
        local fireAtTime = math.clamp(
            tonumber(Config.SyncFireAt) or (holdTime * 0.5),
            0.05,
            math.max(holdTime - 0.05, 0.05)
        )
        local shots = math.clamp(tonumber(Config.SyncVolleyShots) or 4, 1, 20)
        local interval = math.clamp(tonumber(Config.SyncShotInterval) or 0.08, 0.02, 0.5)

        local attachment = root:FindFirstChild("GunRaycastAttachment")
        if not attachment then
            local warmup = tick()
            repeat
                task.wait(0.02)
                attachment = root:FindFirstChild("GunRaycastAttachment")
            until attachment or tick() - warmup > 0.4
        end

        if not syncBehind(killer, root, killerHead) then return end
        local started = tick()
        local shotsFired = 0
        local lastShotAt = -math.huge

        while true do
            if not instanceAlive() or not Candy.Enabled or not Round.active or not isAlive() then break end

            local down = Gun.down(killer)
            if down then hit = true end
            if not syncBehind(killer, root, killerHead) then break end

            local now = tick()
            local elapsed = now - started
            if not down and shotsFired < shots and elapsed >= fireAtTime
                and (shotsFired == 0 or now - lastShotAt >= interval) then
                RunService.Heartbeat:Wait()
                if not instanceAlive() or not Candy.Enabled or not Round.active or not isAlive() then break end
                if Gun.down(killer) then
                    hit = true
                else
                    if not syncBehind(killer, root, killerHead) then break end
                    if Gun.fire(killer, gun, true) then firedAny = true end
                    shotsFired = shotsFired + 1
                    lastShotAt = tick()
                end
            end

            if tick() - started >= holdTime then break end
            RunService.Heartbeat:Wait()
        end

        if Gun.down(killer) then hit = true end
    end)
    if not ok then warn("[teleportShoot] " .. tostring(err)) end

    -- Only restore a living body. After a death the corpse must not be moved.
    if instanceAlive() and isAlive() and root.Parent and LocalPlayer.Character == char then
        root.CFrame = originalCF
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
    Phys.clear(root)
    for part, coll in pairs(saved) do
        if part and part.Parent then part.CanCollide = coll end
    end
    if hum and hum.Parent and autoRotate ~= nil then hum.AutoRotate = autoRotate end

    Motion.shooting = false
    dbg("teleportShoot hit=", tostring(hit), "fired=", tostring(firedAny))
    return hit, firedAny
end

function Gun.isDrop(obj)
    if obj:IsA("BasePart") and obj.Name == "GunDrop" then return true end
    if obj:IsA("Tool") and obj.Name:lower():find("gun") then
        local p = obj.Parent
        if p == LocalPlayer.Character then return false end
        if p and p:IsA("Model") and playerFromCharacter(p) then return false end
        if p and p:IsA("Backpack") then return false end
        return true
    end
    return false
end
function Gun.dropPos(obj)
    if obj:IsA("BasePart") then return obj.Position end
    local handle = obj:FindFirstChild("Handle")
    if handle and handle:IsA("BasePart") then return handle.Position end
    local any = obj:FindFirstChildWhichIsA("BasePart")
    return any and any.Position or nil
end
function Gun.nearestDrop(anyDistance)
    local root = getRoot()
    if not root then return nil end
    local nearest, best = nil, math.huge

    local function consider(obj)
        if not Gun.isDrop(obj) then return end
        local pos = Gun.dropPos(obj)
        if not pos then return end
        local d = (pos - root.Position).Magnitude
        if d < best then
            best = d
            nearest = { obj = obj, pos = pos, dist = d }
        end
    end

    local function scan(container, depth)
        for _, obj in ipairs(container:GetChildren()) do
            consider(obj)
            if depth > 0 and (obj:IsA("Model") or obj:IsA("Folder")) then
                scan(obj, depth - 1)
            end
        end
    end
    scan(Workspace, 3)

    if nearest and (anyDistance or nearest.dist <= Config.GunDistance) then
        return nearest
    end
    return nil
end
function Gun.waitFor(timeout)
    local t0 = tick()
    while tick() - t0 < (timeout or 2) do
        if Gun.has() then return true end
        task.wait(0.1)
    end
    return Gun.has()
end
function Gun.waitForDrop(timeout)
    local t0 = tick()
    while tick() - t0 < (timeout or 5) do
        if not Candy.Enabled or not Round.active or not isAlive() then return false end
        if Gun.nearestDrop(true) then return true end
        task.wait(0.2)
    end
    return false
end
function Gun.toDrop(silent)
    if Motion.teleporting or Motion.shooting or Fling.enabled or Revenge.active then
        return false
    end
    if not instanceAlive() then return false end
    if Gun.has() then return true end
    if Hide.active then Hide.unhide() end

    local info = Gun.nearestDrop(true)
    if not info then
        if not silent then print("[candy] no dropped gun") end
        return false
    end
    local destroyY = tonumber(Workspace.FallenPartsDestroyHeight) or -500
    if info.pos.Y <= destroyY + 60 then
        dbg("dropped gun is in the void; skipping")
        return false
    end

    local root = getRoot()
    if not root then return false end
    local charAtStart = LocalPlayer.Character

    local handle
    if info.obj:IsA("BasePart") then
        handle = info.obj
    else
        handle = info.obj:FindFirstChild("Handle")
            or info.obj:FindFirstChildWhichIsA("BasePart")
    end

    Motion.teleporting = true
    Motion.cancelTween()
    local originalCF = root.CFrame

    local ok, result = pcall(function()
        fireTouch(root, handle)
        task.wait(0.15)

        if not Gun.has() then
            local t0 = tick()
            while tick() - t0 < 1.2 and not Gun.has() do
                if not instanceAlive() or LocalPlayer.Character ~= charAtStart
                    or not Candy.Enabled or not Round.active or not isAlive() then break end

                local fresh = Gun.nearestDrop(true)
                local pos = fresh and fresh.pos or info.pos
                local h = handle
                if fresh and fresh.obj ~= info.obj then
                    if fresh.obj:IsA("BasePart") then
                        h = fresh.obj
                    else
                        h = fresh.obj:FindFirstChild("Handle")
                            or fresh.obj:FindFirstChildWhichIsA("BasePart")
                    end
                end

                local rr = getRoot()
                if rr then
                    rr.CFrame = CFrame.new(pos + Vector3.new(0, 1.5, 0))
                    rr.AssemblyLinearVelocity = Vector3.zero
                    rr.AssemblyAngularVelocity = Vector3.zero
                    if h then fireTouch(rr, h) end
                end
                task.wait(0.05)
            end
        end
        return Gun.has()
    end)

    Motion.teleporting = false
    local got = ok and result == true

    if not got then
        local r = getRoot()
        if r and instanceAlive() and isAlive()
            and LocalPlayer.Character == charAtStart then
            r.CFrame = originalCF
        end
    else
        Gun.equip()
    end

    dbg("teleportToGun got=", tostring(got))
    return got
end

-- ==================== FLING ====================
Fling.bodySaved = {}
function Fling.setBody(enabled)
    local char = LocalPlayer.Character
    if not char then return end
    if enabled then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and Fling.bodySaved[part] == nil then
                Fling.bodySaved[part] = { CanCollide = part.CanCollide, Massless = part.Massless }
                part.CanCollide = false
                part.Massless = true
            end
        end
    else
        for part, state in pairs(Fling.bodySaved) do
            if part and part.Parent then
                part.CanCollide = state.CanCollide
                part.Massless = state.Massless
            end
        end
        table.clear(Fling.bodySaved)
    end
end
function Fling.stop()
    if Fling.loop then Fling.loop:Disconnect(); Fling.loop = nil end
    if Fling.spin then Fling.spin:Disconnect(); Fling.spin = nil end

    local root = getRoot()
    if root then
        root.AssemblyAngularVelocity = Vector3.zero
        root.AssemblyLinearVelocity = Vector3.zero
        if Fling.originalCF and LocalPlayer.Character == Fling.char then
            root.CFrame = Fling.originalCF
        end
        Phys.clear(root)
    end

    Fling.setBody(false)
    local hum = getHumanoid()
    if hum then
        hum.PlatformStand = false
        hum.AutoRotate = true
    end

    Fling.target = nil
    Fling.originalCF = nil
    Fling.char = nil
    Fling.enabled = false
end
function Fling.start(target)
    if Motion.shooting or Motion.teleporting then return false end
    if not instanceAlive() then return false end
    if not target or not target.Character then return false end
    local root = getRoot()
    local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
    if not root or not targetRoot then return false end

    if Fling.enabled then Fling.stop() end
    if Hide.active then Hide.unhide() end
    Motion.cancelTween()

    Fling.target = target
    Fling.originalCF = root.CFrame
    Fling.char = LocalPlayer.Character
    Fling.enabled = true
    Fling.setBody(true)

    Fling.loop = RunService.Heartbeat:Connect(function()
        if not Fling.enabled or not instanceAlive() or not Candy.Enabled or not Round.active
            or Motion.shooting or Motion.teleporting then
            Fling.stop()
            return
        end
        local myRoot = getRoot()
        if not myRoot or LocalPlayer.Character ~= Fling.char then Fling.stop(); return end
        if not Fling.target or not Fling.target.Character then Fling.stop(); return end

        local targetChar = Fling.target.Character
        local tr = targetChar:FindFirstChild("HumanoidRootPart")
        local th = targetChar:FindFirstChild("Head")
        local hum = targetChar:FindFirstChildOfClass("Humanoid")
        if not tr or not hum or hum.Health <= 0 then Fling.stop(); return end

        myRoot.CFrame = tr.CFrame
        if th then Phys.set(myRoot, th) end
    end)

    Fling.spin = RunService.Heartbeat:Connect(function()
        if not Fling.enabled or not instanceAlive() then return end
        local myRoot = getRoot()
        if not myRoot or LocalPlayer.Character ~= Fling.char then
            Fling.stop()
            return
        end
        myRoot.AssemblyAngularVelocity = Vector3.new(0, 99999, 0)
        task.wait(0.15)
        if not Fling.enabled then return end
        myRoot.AssemblyAngularVelocity = Vector3.zero
        task.wait(0.08)
    end)

    return true
end
function Fling.player(target, timeout)
    if not target or not target.Character then return false end
    if Fling.enabled then Fling.stop() end

    local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return false end
    local startPos = targetRoot.Position
    local myChar = LocalPlayer.Character

    if not Fling.start(target) then return false end

    local t0 = tick()
    local displaced = false
    while tick() - t0 < (timeout or 2) do
        task.wait(0.05)
        if not instanceAlive() or LocalPlayer.Character ~= myChar
            or not Candy.Enabled or not Round.active or not isAlive() then break end
        local char = target.Character
        local tr = char and char:FindFirstChild("HumanoidRootPart")
        if not tr then displaced = true; break end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then displaced = true; break end
        if (tr.Position - startPos).Magnitude >= 5 or tr.AssemblyLinearVelocity.Magnitude > 100 then
            displaced = true
            break
        end
    end

    Fling.stop()
    return displaced
end

-- ==================== WAITING FOR YOUR TURN ====================
function WaitTurn.findOverlay()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    local main = pg and pg:FindFirstChild("MainGUI")
    local gameGui = main and main:FindFirstChild("Game")
    local overlay = gameGui and gameGui:FindFirstChild("Waiting")
    if overlay and overlay:IsA("ImageLabel") then return overlay end
    return nil
end
function WaitTurn.visible()
    local overlay = WaitTurn.findOverlay()
    if not overlay or not overlay.Visible then return false end
    local node = overlay.Parent
    while node do
        if node:IsA("GuiObject") and not node.Visible then return false end
        if node:IsA("LayerCollector") and not node.Enabled then return false end
        node = node.Parent
    end
    local image = tostring(overlay.Image or "")
    return image:find(WaitTurn.imageId, 1, true) ~= nil
end
function WaitTurn.poll()
    local now = tick()
    if now - WaitTurn.lastCheck < 0.12 then return WaitTurn.active end
    WaitTurn.lastCheck = now

    local visible = WaitTurn.visible()
    if visible then
        if not WaitTurn.active then
            if WaitTurn.clearedAt == 0 or now - WaitTurn.clearedAt >= 0.5 then
                WaitTurn.handled = false
                WaitTurn.lastAttempt = 0
            end
            dbg("WAITING FOR YOUR TURN detected")
        end
        WaitTurn.active = true
        WaitTurn.clearedAt = 0
    elseif WaitTurn.active then
        WaitTurn.active = false
        WaitTurn.clearedAt = now
        dbg("WAITING FOR YOUR TURN cleared")
    end
    return WaitTurn.active
end
function WaitTurn.flingMurderer()
    if not Candy.Enabled or not Round.active or not isAlive() then return false end
    local killer = Killer.find()
    if not killer or not killer.Character then return false end
    Hide.unhide()
    local ok, displaced = pcall(Fling.player, killer, 2.0)
    if not ok then
        warn("[waiting] fling failed: " .. tostring(displaced))
        return false
    end
    dbg("waiting fling", killer.Name, "displaced=", tostring(displaced))
    return displaced == true
end
function WaitTurn.handle()
    if not WaitTurn.handled and tick() - WaitTurn.lastAttempt >= 2.5 then
        WaitTurn.lastAttempt = tick()
        if WaitTurn.flingMurderer() then
            WaitTurn.handled = true
        end
    end
    Motion.cancelTween()
    Candy.Busy = false
    Candy.Target = nil
    if Candy.Enabled and Config.HideUnderMap and isAlive() and not Candy.Hidden then
        Hide.hide()
    end
end

-- ==================== KNIFE SWEEP ====================
local Knife = { saved = {} }
function Knife.set(player, size)
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if not Knife.saved[player] then
        Knife.saved[player] = {
            Size = hrp.Size,
            Transparency = hrp.Transparency,
            CanCollide = hrp.CanCollide,
        }
    end

    if size then
        hrp.Size = Vector3.new(size, size, size)
        hrp.Transparency = 0.7
        hrp.CanCollide = false
    else
        local old = Knife.saved[player]
        if old then
            hrp.Size = old.Size
            hrp.Transparency = old.Transparency
            hrp.CanCollide = old.CanCollide
        end
        Knife.saved[player] = nil
    end
end
function Knife.restore()
    for player in pairs(Knife.saved) do
        if player.Parent then Knife.set(player, nil) end
    end
    table.clear(Knife.saved)
end
function Knife.get()
    local char = LocalPlayer.Character
    if not char then return nil end
    local knife = char:FindFirstChild("Knife")
    if knife then return knife end
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then backpack = char:FindFirstChildOfClass("Backpack") end
    knife = backpack and backpack:FindFirstChild("Knife")
    if not knife then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        pcall(function() hum:EquipTool(knife) end)
        local t0 = tick()
        repeat
            task.wait(0.05)
            knife = char:FindFirstChild("Knife")
        until knife or tick() - t0 > 1.5
    end
    return knife
end
function Knife.sweep()
    if not isAlive() then return 0 end
    if Round.myRole() ~= "Murderer" and not Killer.hasKnife(LocalPlayer) then return 0 end

    local knife = Knife.get()
    if not knife then
        local t0 = tick()
        while tick() - t0 < 2 and not knife do
            task.wait(0.15)
            knife = Knife.get()
        end
    end
    if not knife then return 0 end

    local events = knife:FindFirstChild("Events")
    local touched = events and events:FindFirstChild(Config.KnifeEvent)
    if not touched or not touched:IsA("RemoteEvent") then
        warn("[knife] " .. Config.KnifeEvent .. " missing")
        return 0
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then Knife.set(player, Config.HitboxSize) end
    end
    task.wait(0.12)

    local stabbed = events:FindFirstChild("KnifeStabbed")
    if stabbed and stabbed:IsA("RemoteEvent") then
        pcall(function() stabbed:FireServer() end)
        task.wait(0.06)
    end

    local killed = 0
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and hrp then
                pcall(function() touched:FireServer(hrp) end)
                task.wait(0.04)
            end
        end
    end

    task.wait(0.25)
    Knife.restore()

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and Round.isDead(player) then killed = killed + 1 end
    end
    dbg("knifeSweep killed=", killed)
    return killed
end

-- ==================== COMBAT ====================
local Combat = {}
function Combat.shootKiller(id)
    if not workerOK(id) or not Round.active or not isAlive() then return false end
    if not Gun.has() then return false end

    local hit, fired = Gun.shoot(true)
    if not fired then return false end
    if hit or not Killer.exists() then return true end

    Motion.cancelTween()
    Hide.hide()
    dbg("shot missed; hiding for", Config.MissRetryDelay, "seconds")

    local retryAt = tick() + math.max(tonumber(Config.MissRetryDelay) or 4, 0.5)
    while workerOK(id) and Round.active and isAlive() and tick() < retryAt do
        if not Killer.exists() then break end
        if WaitTurn.poll() then
            WaitTurn.handle()
            break
        end
        task.wait(0.1)
    end

    if workerOK(id) and Round.active and isAlive() and Killer.exists() and Hide.active then
        Hide.unhide()
    end
    return false
end
function Combat.phase(id)
    if not Config.AutoCombat then return false end
    if not workerOK(id) or not Round.active or not isAlive() then return false end
    if Revenge.active or tick() < Motion.lockUntil then return false end
    if not Bag.full() then return false end

    Hide.unhide()
    Round.refresh()
    local role = Round.myRole() or Round.waitRole(3)
    if not workerOK(id) or not isAlive() or not Round.active then return false end
    dbg("combat role=", tostring(role))

    if role == "Murderer" or Killer.hasKnife(LocalPlayer) then
        Knife.sweep()
        return true
    end

    if Gun.has() then
        Gun.equip()
        Combat.shootKiller(id)
        return true
    end

    if role == "Innocent" or role == nil then
        local holder = Gun.sheriff() or Gun.holder()
        if holder then
            for attempt = 1, 2 do
                if not workerOK(id) or not Round.active or not isAlive() then return false end
                if not Gun.has() and Gun.waitForDrop(0.2) then break end
                dbg("flinging gun holder", holder.Name, "attempt", attempt)
                Fling.player(holder, 2.0)
                if Gun.waitForDrop(4) then break end
            end
        end
    end

    if not Gun.has() then Gun.waitForDrop(4) end
    if not Gun.has() then
        Gun.toDrop(true)
        Gun.waitFor(1.5)
    end

    if Gun.has() and isAlive() and Round.active then
        Gun.equip()
        Combat.shootKiller(id)
        return true
    end
    return false
end
function Combat.untilEnd(id)
    if Killer.isLocal() then
        local ok, err = pcall(Combat.phase, id)
        if not ok then warn("[combat] " .. tostring(err)) end
        return
    end

    local lastTry = 0
    while workerOK(id) and Round.active and isAlive() and Bag.full() do
        if WaitTurn.poll() then
            WaitTurn.handle()
            task.wait(0.15)
            continue
        end
        if not Killer.exists() then break end

        if tick() - lastTry >= 1.5 then
            lastTry = tick()
            local ok, err = pcall(Combat.phase, id)
            if not ok then warn("[combat] " .. tostring(err)) end
        end
        task.wait(0.2)
    end
end

-- ==================== FARM LOOP ====================
local Farm = {}
function Farm.run(id)
    local idleSince = tick()
    while workerOK(id) and Round.active and isAlive() do
        -- A fling, shot, gun teleport or revenge owns the root right now.
        -- Waiting avoids a false "unreachable" penalty on the chosen candy.
        if Motion.busy() then
            task.wait(0.1)
            continue
        end

        if WaitTurn.poll() then
            WaitTurn.handle()
            task.wait(0.1)
            continue
        end

        -- No murderer means the round is effectively over: stay hidden until a
        -- candy is actually visible again.
        if not Killer.exists() then
            local list = Scan.list(false)
            if #list == 0 then
                if not Candy.Hidden and tick() - idleSince > 0.4 then Hide.hide() end
                task.wait(0.15)
                continue
            end
        end

        if Bag.full() then
            Hide.unhide()
            return "full"
        end

        local list = Scan.list(false)
        local target, waitHint = Scan.best(list)
        if not target then
            if waitHint then
                -- Every safe candy is cooling down after a failed pickup.
                task.wait(math.min(waitHint, 0.25))
            else
                if not Candy.Hidden and tick() - idleSince > 0.4 then Hide.hide() end
                task.wait(0.1)
            end
        else
            idleSince = tick()

            -- The first candy of a round gets one instant snap; waiting for
            -- the tween from spawn (or from under the map) costs the opening
            -- seconds. Round.serial is the guard: at most one snap per round.
            if Candy.FirstTeleportSerial ~= Round.serial then
                if Move.firstTeleport(target) then
                    Candy.FirstTeleportSerial = Round.serial
                elseif Candy.Hidden then
                    Hide.unhideForCandy(target)
                end
            elseif Candy.Hidden then
                Hide.unhideForCandy(target)
            end

            local got, reason = Move.collect(target, id)
            if not got then
                if reason == "unreachable" then
                    Scan.markFailure(target.obj)
                elseif reason ~= "gone" and reason ~= "disabled" and reason ~= "roundEnded" then
                    Candy.SkipUntil[target.obj] = math.max(
                        Candy.SkipUntil[target.obj] or 0,
                        tick() + 0.4
                    )
                end
                Candy.LastScan = 0
                task.wait(0.04)
            end
        end
    end
    return Round.active and "stopped" or "roundEnded"
end

-- ==================== DEATH REVENGE ====================
-- Dying while the shot is in flight used to leave the revenge fling racing the
-- combat loop; now the shot publishes its intent, the combat loop backs off,
-- and the fling waits until the root is free.
local Death = { hum = nil, gen = 0, token = 0 }
function Death.on()
    if not instanceAlive() then return end
    if not Candy.Enabled or not Round.active then return end
    local wasShooting = Motion.shooting

    local destroyY = tonumber(Workspace.FallenPartsDestroyHeight) or -500
    local voidDeath = false
    if Hide.lastY then
        voidDeath = Hide.lastY <= destroyY + 40
            or (Hide.surfaceY and Hide.lastY < Hide.surfaceY - 150)
    end
    if Hide.active or voidDeath then
        Hide.hideDeaths = Hide.hideDeaths + 1
        local block = Hide.hideDeaths >= 2 and 600 or 180
        Hide.blockedUntil = math.max(Hide.blockedUntil, tick() + block)
        dbg("death while hiding/in the void; hiding paused for", block, "seconds")
    end
    Hide.clear()

    Death.token = Death.token + 1
    local token = Death.token
    local serial = Round.serial

    if wasShooting then
        -- Keep the combat loop off the root long enough for the fling.
        Motion.lockUntil = tick() + 5
    end
    dbg("death detected" .. (wasShooting and " while shooting" or "")
        .. "; waiting for respawn to fling the murderer")

    -- Claim the root for the whole death/respawn window. This stops the combat
    -- loop from starting a fresh teleport-shoot while the revenge is pending.
    Revenge.active = true
    task.spawn(function()
        local ok, err = pcall(Death.revenge, serial, token)
        if not ok then warn("[revenge] " .. tostring(err)) end
        if token == Death.token or not Candy.Enabled then
            Revenge.active = false
        end
    end)
end

function Death.revenge(serial, token)
    while Candy.Enabled and Round.active and Round.serial == serial and not isAlive() do
        if token ~= Death.token or not instanceAlive() then return end
        task.wait(0.15)
    end
    if token ~= Death.token or not instanceAlive() then return end
    if not Candy.Enabled or not Round.active or Round.serial ~= serial or not isAlive() then return end

    Hide.unhide()
    dbg("respawned after a death; flinging murderer")

    local attempts = 0
    while attempts < 20 do
        if token ~= Death.token or not instanceAlive() then break end
        if not Candy.Enabled or not Round.active or Round.serial ~= serial or not isAlive() then break end
        if not Killer.exists() then break end

        local killer = Killer.find()
        if not killer then break end

        -- Never fight an in-flight shot or gun teleport for the root.
        local waited = 0
        while (Motion.shooting or Motion.teleporting) and waited < 3 do
            task.wait(0.1)
            waited = waited + 0.1
            if token ~= Death.token or not instanceAlive() then break end
        end
        if not Candy.Enabled or not Round.active or Round.serial ~= serial or not isAlive() then break end

        attempts = attempts + 1
        Hide.unhide()
        Motion.cancelTween()
        local ok, displaced = pcall(Fling.player, killer, 2.5)
        dbg("revenge fling", killer.Name, "attempt", attempts, "displaced=", tostring(displaced))
        if not ok then break end
        if displaced then break end
        task.wait(0.35)
    end
end

function Death.attach(char)
    if not instanceAlive() then return end
    Death.gen = Death.gen + 1
    local generation = Death.gen

    -- The old hide point belongs to the old body.
    Hide.clear()

    if Death.hum then
        pcall(function() Death.hum:Disconnect() end)
        Death.hum = nil
    end
    if not char then return end

    local function connect(hum)
        if generation ~= Death.gen then return end
        if LocalPlayer.Character ~= char then return end
        if not hum or not hum.Parent then return end
        local ok, conn = pcall(function() return hum.Died:Connect(Death.on) end)
        if ok and conn then Death.hum = conn end
    end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        connect(hum)
    else
        task.spawn(function()
            local waited = char:WaitForChild("Humanoid", 5)
            if waited and generation == Death.gen then connect(waited) end
        end)
    end
end

Death.charConn = onCharacterAdded(Death.attach)
if LocalPlayer.Character then Death.attach(LocalPlayer.Character) end

-- ==================== AUTO REJOIN / SERVER HOP ====================
local Rejoin = { conn = nil, started = false, pendingKickRevenge = false, intent = nil }
do
    local ok, stored = pcall(function() return genv.__mm2candy_rejoin end)
    if ok and type(stored) == "table" then
        genv.__mm2candy_rejoin = nil
        local age = os.time() - (tonumber(stored.at) or 0)
        if age >= 0 and age <= 300 then Rejoin.intent = stored end
    end
end
Rejoin.pendingKickRevenge = Rejoin.intent ~= nil
    and Rejoin.intent.kick == true
    and Rejoin.intent.farming == true

function Rejoin.queue(intent)
    if not Config.QueueReexecute then return false end
    local url = tostring(Config.ReexecuteUrl or "")
    if url == "" then return false end

    local env = getgenv()
    local queue = env.queue_on_teleport or env.queueonteleport
        or env.queue_on_tp or env.queueontp
    if type(queue) ~= "function" then
        dbg("re-execution queue unavailable")
        return false
    end

    local intentCode = "nil"
    if type(intent) == "table" then
        local jobId = tostring(intent.jobId or game.JobId or "")
        intentCode = string.format(
            "{ kick = %s, farming = %s, jobId = %q, at = %d }",
            tostring(intent.kick == true),
            tostring(intent.farming == true),
            jobId,
            os.time()
        )
    end

    local loader = string.format([[
local url = %q
local source
for _ = 1, 8 do
    local ok, body = pcall(function() return game:HttpGet(url) end)
    if ok and type(body) == "string" and #body > 0 then
        source = body
        break
    end
    task.wait(2)
end
if source then
    getgenv().__mm2candy_rejoin = %s
    local fn, err = loadstring(source)
    if fn then
        fn()
    else
        warn("[AutoCandyFarm] re-execute compile failed: " .. tostring(err))
    end
else
    warn("[AutoCandyFarm] re-execute download failed")
end
]], url, intentCode)

    local ok = pcall(queue, loader)
    dbg("queued re-execution", ok and "ok" or "failed")
    return ok
end

function Rejoin.fetchServers(placeId)
    local pages = math.clamp(tonumber(Config.ServerHopPages) or 2, 1, 5)
    local servers = {}
    local cursor = nil

    for _ = 1, pages do
        local url = string.format(
            "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Desc&excludeFullGames=true&limit=100",
            placeId
        )
        if cursor and cursor ~= "" then
            local okEncode, encoded = pcall(function()
                return S.HttpService:UrlEncode(cursor)
            end)
            if not okEncode or type(encoded) ~= "string" then break end
            url = url .. "&cursor=" .. encoded
        end

        local ok, body = pcall(function()
            return game:HttpGet(url)
        end)
        if not ok or type(body) ~= "string" or body == "" then
            dbg("server list fetch failed:", tostring(body))
            break
        end

        local okDecode, data = pcall(function()
            return S.HttpService:JSONDecode(body)
        end)
        if not okDecode or type(data) ~= "table" or type(data.data) ~= "table" then
            dbg("server list decode failed:", tostring(data))
            break
        end

        for _, srv in ipairs(data.data) do
            table.insert(servers, srv)
        end

        cursor = data.nextPageCursor
        if type(cursor) ~= "string" or cursor == "" then break end
        task.wait(0.1)
    end

    if #servers == 0 then return nil end
    return servers
end

function Rejoin.pickServer(placeId, excludeJobId)
    local servers = Rejoin.fetchServers(placeId)
    if not servers then return nil, nil end

    local minFill = math.clamp(tonumber(Config.ServerHopMinFill) or 0.5, 0, 1)
    local best, fallback = nil, nil

    for _, srv in ipairs(servers) do
        if type(srv) == "table"
            and type(srv.id) == "string"
            and type(srv.playing) == "number"
            and type(srv.maxPlayers) == "number"
            and srv.id ~= excludeJobId
            and srv.playing < srv.maxPlayers then
            local info = {
                id = srv.id,
                playing = srv.playing,
                maxPlayers = srv.maxPlayers,
                fill = srv.playing / math.max(srv.maxPlayers, 1),
                ping = tonumber(srv.ping) or math.huge,
                fps = tonumber(srv.fps) or 0,
            }

            if info.fill >= minFill then
                if not best
                    or info.ping < best.ping
                    or (info.ping == best.ping and info.playing > best.playing)
                    or (info.ping == best.ping and info.playing == best.playing and info.fps > best.fps) then
                    best = info
                end
            elseif Config.ServerHopAllowFallback ~= false then
                if not fallback
                    or info.playing > fallback.playing
                    or (info.playing == fallback.playing and info.ping < fallback.ping) then
                    fallback = info
                end
            end
        end
    end

    local chosen = best or fallback
    return chosen and chosen.id or nil, chosen
end

function Rejoin.attempt(reason, intent)
    if not Config.AutoRejoin then return false end
    dbg("auto-rejoin triggered", tostring(reason))

    local rejoinIntent = intent or {
        kick = true,
        farming = Candy.Enabled and Round.active,
    }

    Rejoin.queue(rejoinIntent)
    task.wait(0.1)

    local ok = pcall(function()
        S.TeleportService:Teleport(game.PlaceId, LocalPlayer)
    end)
    if ok then
        Stats.addRejoin()
        Stats.save()
    end
    dbg("rejoin teleport", ok and "sent" or "failed")
    return ok
end

function Rejoin.hop(reason)
    if not Config.AutoRejoin or Rejoin.started then return end
    Rejoin.started = true
    dbg("server hop triggered", tostring(reason))

    Rejoin.queue({ kick = false, farming = Candy.Enabled })

    task.spawn(function()
        local minFill = math.clamp(tonumber(Config.ServerHopMinFill) or 0.5, 0, 1)
        local currentJobId = game.JobId
        local counted = false

        for _ = 1, 12 do
            if not instanceAlive() or not Candy.Enabled then
                Rejoin.started = false
                return
            end

            local jobId, info = Rejoin.pickServer(game.PlaceId, game.JobId)
            if jobId then
                dbg(string.format(
                    "hop pick %s (%d/%d, %.0f%%, ping %s)",
                    jobId, info.playing, info.maxPlayers,
                    (info.fill or 0) * 100, tostring(info.ping)
                ))
                if info.fill < minFill then
                    dbg("no half-full server found; using the most populated fallback")
                end

                local ok = pcall(function()
                    S.TeleportService:TeleportToPlaceInstance(game.PlaceId, jobId, LocalPlayer)
                end)
                if ok then
                    if not counted then
                        counted = true
                        Stats.addHop()
                        Stats.save()
                    end
                    task.wait(3)
                    if game.JobId ~= currentJobId then return end
                end
            else
                dbg("no suitable public server found; retrying")
            end

            task.wait(math.max(tonumber(Config.ServerHopRetryDelay) or 5, 1))
        end

        if not instanceAlive() or not Candy.Enabled then
            Rejoin.started = false
            return
        end

        dbg("server hop retries exhausted; falling back to Teleport")
        local fallbackOk = pcall(function()
            S.TeleportService:Teleport(game.PlaceId, LocalPlayer)
        end)
        if fallbackOk and not counted then
            Stats.addHop()
            Stats.save()
        end
        Rejoin.started = false
    end)
end

function Rejoin.setup()
    if not Config.AutoRejoin or Rejoin.conn then return end
    local ok, connection = pcall(function()
        return S.GuiService.ErrorMessageChanged:Connect(function(errorMessage)
            if not instanceAlive() then return end
            if type(errorMessage) ~= "string" or errorMessage == "" then return end
            print("Error detected: " .. tostring(errorMessage))
            if LocalPlayer then
                Rejoin.attempt("GuiService: " .. tostring(errorMessage), {
                    kick = true,
                    farming = Candy.Enabled and Round.active,
                })
            end
        end)
    end)
    if ok and connection then
        Rejoin.conn = connection
    else
        dbg("GuiService.ErrorMessageChanged unavailable:", tostring(connection))
    end
end

-- Rejoin kick revenge: only touch the round that was already live.
function Rejoin.runKickRevenge()
    if not Candy.Enabled then return end
    dbg("rejoin revenge: checking the rejoined server")

    local deadline = tick() + 10
    while instanceAlive() and tick() < deadline do
        if not Candy.Enabled then return end

        if isAlive() then
            if not Round.active then
                Round.detect()
                if not Round.active and not Round.myRole() then Round.waitRole(1) end
            end

            if Round.active then
                if Round.startTime > 0 and tick() - Round.startTime < 4 then
                    dbg("rejoin revenge: a new round started; waiting instead")
                    return
                end

                local killer = nil
                local killerWaitUntil = tick() + 4
                repeat
                    killer = Killer.find()
                    if killer and not Round.isDead(killer) then break end
                    if not Round.myRole() then Round.waitRole(1) end
                    task.wait(0.4)
                until tick() >= killerWaitUntil

                if not killer or Round.isDead(killer) then
                    dbg("rejoin revenge: no living murderer in the active round")
                    return
                end

                task.wait(0.5)

                local attempts = 0
                while instanceAlive() and attempts < 3 and Candy.Enabled
                    and Round.active and isAlive() do
                    killer = Killer.find()
                    if not killer or Round.isDead(killer) then break end
                    attempts = attempts + 1
                    Hide.unhide()
                    local ok, displaced = pcall(Fling.player, killer, 2.5)
                    dbg("rejoin revenge fling", killer.Name, "attempt", attempts,
                        "displaced=", tostring(displaced))
                    if not ok then break end
                    task.wait(0.3)
                end
                return
            end
        end

        task.wait(0.5)
    end

    dbg("rejoin revenge: no live round after the rejoin")
end

-- ==================== AUTO-BUY HALLOWEEN BOX '26 ====================
-- The shop's own mystery-box flow calls
--   Shop.OpenCrate:InvokeServer(boxId, "MysteryBox", currency)
-- so that is exactly what this uses. It returns the rewarded item id.
do
    local BoxBuy = {
        remoteRef = nil,
        lastTry = 0,
        lastWarn = 0,
        itemService = nil,
        boxType = nil,
        profileModule = nil,
    }

    local function childOf(parent, name)
        return parent and parent:FindFirstChild(name) or nil
    end

    function BoxBuy.remote()
        local cached = BoxBuy.remoteRef
        if cached and cached.Parent then return cached end
        local remotes = S.ReplicatedStorage:FindFirstChild("Remotes")
        local shop = childOf(remotes, "Shop")
        local remote = childOf(shop, "OpenCrate")
        if remote and remote:IsA("RemoteFunction") then
            BoxBuy.remoteRef = remote
            return remote
        end
        return nil
    end

    function BoxBuy.params()
        local services = S.ReplicatedStorage:FindFirstChild("ClientServices")
        local module = childOf(services, "ItemService")
        if not module then return nil end
        local ok, service = pcall(require, module)
        if not ok or type(service) ~= "table" then return nil end
        BoxBuy.itemService = service
        local okBox, box = pcall(function()
            return service:GetItemInfo(Config.AutoBuyBoxId, "MysteryBox")
        end)
        if okBox and type(box) == "table" then
            BoxBuy.boxType = box.BoxType
        end
        return service
    end

    function BoxBuy.candies()
        if not BoxBuy.profileModule then
            local modules = S.ReplicatedStorage:FindFirstChild("Modules")
            BoxBuy.profileModule = childOf(modules, "ProfileData")
        end
        if BoxBuy.profileModule then
            local ok, profile = pcall(require, BoxBuy.profileModule)
            if ok and type(profile) == "table" then
                local materials = profile.Materials
                local owned = materials and materials.Owned
                local amount = owned and tonumber(owned[Config.AutoBuyBoxCurrency])
                if amount then return amount end
            end
        end
        return Bag.count()
    end

    function BoxBuy.resolve(rewardId)
        local service = BoxBuy.itemService or BoxBuy.params()
        if not service then return nil end
        local boxType = BoxBuy.boxType or "Weapons"
        local id = tostring(rewardId)
        local okItem, item = pcall(function()
            return service:FindItemInfo(id, boxType)
                or service:FindItemInfo(id, "Weapons")
        end)
        if not okItem or type(item) ~= "table" then return nil end
        local okName, displayName = pcall(function()
            return service:GetDisplayName(item)
        end)
        local shownName = okName and type(displayName) == "string"
            and displayName ~= "" and displayName or nil
        local rarity = tostring(item.Rarity or "?")
        return {
            id = id,
            name = shownName or tostring(item.ItemName or id),
            type = tostring(item.ItemType or "Item"),
            rarity = rarity,
            color = Stats.colorForRarity(rarity),
        }
    end

    function BoxBuy.report(rewardId)
        local item = BoxBuy.resolve(rewardId)
        if not item then
            if Config.DebugLog then
                warn("[box] opened a crate but could not resolve reward id: " .. tostring(rewardId))
            end
            return false
        end
        Stats.addCrate(item)
        Stats.save()
        Stats.webhook(item)
        print(string.format(
            "[AutoCandyFarm] opened %s: %s (%s, %s) | total candies=%d",
            tostring(Config.AutoBuyBoxName or "crate"),
            item.name, item.type, item.rarity, Stats.candies
        ))
        return true
    end

    function BoxBuy.try()
        if not Config.AutoBuyBox or not Candy.Enabled then return false end
        local interval = math.max(tonumber(Config.AutoBuyBoxInterval) or 5, 1)
        if tick() - BoxBuy.lastTry < interval then return false end
        BoxBuy.lastTry = tick()

        local remote = BoxBuy.remote()
        if not remote then
            if Config.DebugLog and tick() - BoxBuy.lastWarn > 30 then
                BoxBuy.lastWarn = tick()
                dbg("box: OpenCrate remote not found")
            end
            return false
        end

        local price = math.max(tonumber(Config.AutoBuyBoxPrice) or 600, 0)
        local have = BoxBuy.candies()
        if have and have < price then
            if Config.DebugLog and tick() - BoxBuy.lastWarn > 30 then
                BoxBuy.lastWarn = tick()
                dbg("box: waiting for candies", have, "/", price)
            end
            return false
        end

        local ok, reward = pcall(function()
            return remote:InvokeServer(
                Config.AutoBuyBoxId, "MysteryBox", Config.AutoBuyBoxCurrency
            )
        end)
        if not ok then
            if Config.DebugLog then
                warn("[box] OpenCrate failed: " .. tostring(reward))
            end
            return false
        end
        if not reward then return false end

        local rewardId
        if type(reward) == "string" then
            rewardId = reward
        elseif type(reward) == "table" then
            rewardId = reward.ItemID or reward.Id or reward.Name
        else
            rewardId = tostring(reward)
        end
        if not rewardId or rewardId == "" then return false end
        return BoxBuy.report(rewardId)
    end

    task.spawn(function()
        while instanceAlive() do
            if Candy.Enabled and Config.AutoBuyBox then
                local ok, err = pcall(BoxBuy.try)
                if not ok then warn("[box] " .. tostring(err)) end
            end
            task.wait(1)
        end
    end)

    -- Persist the running time and counters even during long sessions, so a
    -- crash or kick loses at most a few seconds of stats.
    task.spawn(function()
        while instanceAlive() do
            task.wait(5)
            if not instanceAlive() then return end
            pcall(Stats.save)
        end
    end)

    P.box = {
        try = BoxBuy.try,
        report = BoxBuy.report,
        candies = BoxBuy.candies,
        last = function() return Stats.rewards[#Stats.rewards] end,
    }

    -- Also catch a manual shop open of the same box. ShopService fires this
    -- bindable after its own OpenCrate call; the auto-buy above calls the
    -- remote directly and never fires it, so there is no double report.
    local remotes = S.ReplicatedStorage:FindFirstChild("Remotes")
    local shop = childOf(remotes, "Shop")
    local controller = childOf(shop, "BoxController")
    if controller and controller:IsA("BindableEvent") then
        P.boxConn = controller.Event:Connect(function(results)
            if not instanceAlive() then return end
            if type(results) ~= "table" then return end
            for _, result in ipairs(results) do
                if type(result) == "table"
                    and tostring(result.MysteryBoxId or "") == Config.AutoBuyBoxId
                    and result.RewardedItemId then
                    local rewardId = result.RewardedItemId
                    task.spawn(function()
                        if instanceAlive() then
                            BoxBuy.report(rewardId)
                        end
                    end)
                end
            end
        end)
    end
end

-- ==================== WORKER ====================
local Worker = {}
local function resetForRound()
    Candy.Picked = 0
    Candy.ServerCount = 0
    Candy.Collected = 0
    Candy.GuiReadyAt = tick() + 0.8
    Candy.Cache = {}
    Candy.LastScan = 0
    Candy.Busy = false
    Candy.Target = nil
    Scan.clearMemory()
end

function Worker.run(id)
    if Candy.ActiveWorker and Candy.ActiveWorker ~= id then return end
    Candy.ActiveWorker = id
    Candy.Running = true

    if Rejoin.pendingKickRevenge then
        Rejoin.pendingKickRevenge = false
        local ok, err = pcall(Rejoin.runKickRevenge)
        if not ok then warn("[rejoin] revenge failed: " .. tostring(err)) end
    end

    while instanceAlive() and Candy.Enabled and Candy.ActiveWorker == id do
        if not Round.active then Round.detect() end

        if not Round.active then
            if Candy.Enabled and isAlive() then Hide.hide() end
            task.wait(0.25)
        else
            local serial = Round.serial

            -- Only hide at round start when there is genuinely nothing to farm.
            if Candy.Enabled and isAlive() then
                local list = Scan.list(true)
                if #list == 0 then Hide.hide() end
            end

            if not Round.myRole() then Round.waitRole(3) end

            if instanceAlive() and Candy.Enabled and Round.active and Round.serial == serial then
                resetForRound()

                while instanceAlive() and Candy.Enabled and Round.active
                    and Round.serial == serial and not isAlive() do
                    Hide.unhide()
                    task.wait(0.25)
                end

                if instanceAlive() and Candy.Enabled and Round.active
                    and Round.serial == serial and isAlive() then
                    local ok, status = xpcall(function()
                        return Farm.run(id)
                    end, function(err)
                        return tostring(err) .. "\n" .. debug.traceback("", 2)
                    end)
                    if not ok then
                        warn("[farm] " .. tostring(status))
                        Candy.Busy = false
                        Candy.Target = nil
                    else
                        dbg("farm ended:", tostring(status),
                            Candy.Collected .. "/" .. tostring(bagTarget()))
                    end

                    if instanceAlive() and Candy.Enabled and Round.active
                        and Round.serial == serial and isAlive() and Bag.full() then
                        local okCombat, errCombat = pcall(Combat.untilEnd, id)
                        if not okCombat then warn("[combat] " .. tostring(errCombat)) end
                    end

                    if instanceAlive() and Candy.Enabled and Round.active
                        and Round.serial == serial and isAlive() then
                        Hide.hide()
                    end
                end
            end

            local endedAt = tick()
            while instanceAlive() and Candy.Enabled and Round.active
                and Round.serial == serial do
                local t = Round.readTimer()
                if t and t <= 0 and tick() - endedAt > 1 then
                    Round.markEnd("timer")
                    break
                end
                task.wait(0.25)
            end
        end
    end

    if instanceAlive() and Candy.ActiveWorker == id then
        Motion.cancelTween()
        Fling.stop()
        Knife.restore()
        Candy.Running = false
        Candy.ActiveWorker = nil
        Candy.Busy = false
        Candy.Target = nil
        dbg("worker stopped")
    end
end

-- ==================== CHARACTER RELEASE / TOGGLE ====================
local function releaseCharacter()
    Hide.unhide()
    Motion.cancelTween()
    Fling.stop()
    Knife.restore()

    local root = getRoot()
    if root then
        root.Anchored = false
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        Phys.clear(root)
    end

    local hum = getHumanoid()
    if hum then
        hum.PlatformStand = false
        hum.AutoRotate = true
        hum.CameraOffset = Vector3.zero
    end
end

local function toggleCandy(state)
    if not instanceAlive() then return end
    state = not not state
    if state == Candy.Enabled then
        if not state then
            releaseCharacter()
            Noclip.disable()
            AnimLock.disable()
        else
            Noclip.enable()
            AnimLock.enable()
        end
        return
    end

    Candy.Enabled = state
    if state then
        releaseCharacter()
        Noclip.enable()
        AnimLock.enable()
        Scan.clearMemory()
        Candy.Running = true
        Candy.WorkerSerial = (tonumber(Candy.WorkerSerial) or 0) + 1
        local id = Candy.WorkerSerial
        Candy.ActiveWorker = id
        task.spawn(function() Worker.run(id) end)
        print("[AutoCandyFarm] enabled - waiting for round start")
    else
        Candy.ActiveWorker = nil
        Candy.Running = false
        Candy.Busy = false
        Candy.Target = nil
        Death.token = Death.token + 1
        Revenge.active = false
        Motion.lockUntil = 0
        Scan.clearMemory()
        releaseCharacter()
        Noclip.disable()
        AnimLock.disable()
        print("[AutoCandyFarm] disabled")
    end
end

