-- The queued loader can run before Players.LocalPlayer exists. Indexing
-- LocalPlayer.CharacterAdded while it is nil is what threw
-- "attempt to index nil with 'CharacterAdded'" on rejoin/respawn.
local LocalPlayer
do
    local deadline = tick() + 120
    while not Players.LocalPlayer and tick() < deadline do
        task.wait(0.1)
    end
    LocalPlayer = Players.LocalPlayer
end
if not LocalPlayer then
    warn("[AutoCandyFarm] LocalPlayer unavailable; aborting")
    return
end

-- ==================== SINGLE-INSTANCE GUARD ====================
-- The rejoin loader can be queued more than once, and executing the script
-- twice used to tear down the first copy and start a second one. The first
-- loaded copy now owns a heartbeat lease; any later copy exits before it
-- touches P, the character, or the farm.
local genv = getgenv()
local LEASE_KEY = "__mm2candy_lease"
local leaseToken
do
    local now = tick()
    local force = genv.__mm2candy_force == true
    genv.__mm2candy_force = nil

    local lease = genv[LEASE_KEY]
    local fresh = type(lease) == "table"
        and lease.alive == true
        and type(lease.id) == "string"
        and type(lease.heartbeat) == "number"
        and now - lease.heartbeat < 15
        and lease.jobId == game.JobId

    if fresh and not force then
        print("[AutoCandyFarm] already running; duplicate execution ignored"
            .. " (set getgenv().__mm2candy_force = true to replace it)")
        return
    end

    leaseToken = tostring(now) .. ":" .. tostring(math.random(100000, 999999))
        .. ":" .. tostring(game.JobId or "")
    genv[LEASE_KEY] = {
        alive = true,
        heartbeat = now,
        id = leaseToken,
        jobId = game.JobId,
    }
end

-- Always read Players.LocalPlayer at call time; a captured nil value is
-- exactly what made rejoins explode.
local function onCharacterAdded(fn)
    local lp = Players.LocalPlayer
    if not lp then return nil end
    local ok, conn = pcall(function()
        return lp.CharacterAdded:Connect(function(char)
            local good, err = pcall(fn, char)
            if not good then warn("[character] " .. tostring(err)) end
        end)
    end)
    if ok and conn then return conn end
    warn("[character] CharacterAdded unavailable: " .. tostring(conn))
    return nil
end

