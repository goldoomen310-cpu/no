-- ==================== KICK ATTEMPT ====================
-- The "fake ban message" is delivered by kicking the client. Many executors
-- run at CoreScript/RobloxScript identity and can call LocalPlayer:Kick, in
-- which case the native Roblox disconnect dialog shows the fake ban text.
-- If the executor refuses, the custom GUI above is the visible fake ban and
-- the Leave button drives the rejoin.
local function kickWithBanMessage()
    local message = string.format(
        "You have been banned.\n\nReason: %s\nDuration: %s\n\n%s",
        Config.BanReason, Config.BanDuration, Config.BanAppealNote
    )
    local ok = pcall(function()
        LocalPlayer:Kick(message)
    end)
    if ok then
        dbg("client kick attempted")
        return true
    end
    dbg("client kick unavailable; relying on GUI + rejoin")
    return false
end

-- ==================== WIRE IT UP ====================
local gui, leaveBtn = buildBanGui()

-- Queue ourselves immediately so *any* rejoin - manual leave, reconnect,
-- or the kick we are about to perform - re-executes the loader.
Rejoin.queue()

if leaveBtn then
    leaveBtn.MouseButton1Click:Connect(function()
        dbg("Leave clicked")
        Rejoin.attempt("Leave button")
    end)
end

-- Show the fake ban, then attempt the real kick so the native dialog
-- becomes the "ban message". If kick is refused, the custom GUI stays.
task.delay(Config.KickDelay, kickWithBanMessage)

-- ==================== LEASE HEARTBEAT ====================
task.spawn(function()
    while true do
        local lease = genv[LEASE_KEY]
        if type(lease) ~= "table" or lease.id ~= leaseToken then return end
        lease.heartbeat = tick()
        task.wait(Config.LeaseInterval)
    end
end)

print("[FakeBan] loaded - fake ban shown, rejoin loop armed.")
